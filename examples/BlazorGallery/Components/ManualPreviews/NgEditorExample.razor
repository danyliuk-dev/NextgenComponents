        new("Project plan", NgBlockKind.Heading1),
        new("Agree on requirements", NgBlockKind.Bullet),
        new("Review the result", NgBlockKind.Bullet, Bold: true)
    ]);
    private string saved = "";
    private void Save() => saved = document.ToJson();
}
