@page "/forms"
@using System.ComponentModel.DataAnnotations
<PageTitle>Nextgen • Forms and dates</PageTitle>
<div class="ng-scope gallery" data-ng-theme="@(dark ? "dark" : "light")" data-ng-density="@(compact ? "compact" : "normal")"><main>
<nav><a href="/code-examples">Code examples</a><strong><span class="brand-icon">N</span> NEXTGEN COMPONENTS</strong><div class="row"><a href="/data">Data workspace</a><a href="/">Foundation</a><NgSwitch Label="Dark theme" @bind-Value="dark" /><NgCheckBox Label="Compact" @bind-Value="compact" /></div></nav>
<section class="hero"><p class="eyebrow">BLAZOR / FORMS AND DATES 0.48</p><h1>Every detail.<br />In the right place.</h1><p>Plan a team workshop. Search options, choose dates and validate everything together. Dates use yyyy-mm-dd; Sundays are unavailable for the workshop.</p></section>
@if(saved is not null) { <section class="panel" role="status" id="saved"><h2>Workshop saved</h2><p>@saved</p></section> }
<section class="panel"><div class="panel-heading"><h2>Workshop booking</h2><span class="tag">SEARCH + SELECTION</span></div>
<div class="row"><NgCheckBox Label="Read only text and dates" @bind-Value="readOnly"/><NgCheckBox Label="Simulate save failure" @bind-Value="fail"/></div>
<div class="row"><NgCheckBox Label="Read only choices" @bind-Value="choicesReadOnly"/><NgDropDownList Label="Search mode" Items="filterModes" @bind-Value="filterMode"/></div>
<NgForm @key="model" Model="model" OnValidSubmit="Save">
<div class="fields">
<NgTextBox Label="Workshop name" @bind-Value="model.Name" ReadOnly="readOnly" MaxLength="80" HelperText="Required. Use a descriptive name."><PrefixTemplate><span aria-hidden="true">✎</span></PrefixTemplate></NgTextBox>
<NgAutoComplete Label="City" Items="cities" @bind-Value="model.City" FilterMode="@filterMode" MinLength="2" ReadOnly="choicesReadOnly" Placeholder="Type two letters" />
<NgComboBox Label="Facilitator" Items="people" @bind-Value="model.Person" FilterMode="@filterMode" ReadOnly="choicesReadOnly" ShowClearButton><ItemTemplate Context="person"><strong>@person.Label</strong><small> · Facilitator</small></ItemTemplate></NgComboBox>
<NgDateInput ReadOnly="readOnly" Label="Registration deadline" @bind-Value="model.Deadline" Min="min" Max="max" />
<NgDatePicker ReadOnly="readOnly" Label="Workshop date" @bind-Value="model.Date" Min="min" Max="max" DisabledDate="Sunday" />
<NgTimePicker MinuteStep="15" Label="Start time" @bind-Value="model.Time" Min="new TimeOnly(8,0)" Max="new TimeOnly(18,0)" />
<NgDateTimePicker MinuteStep="15" Label="Reminder" @bind-Value="model.Reminder" Min="new DateTime(2026,1,1)" Max="new DateTime(2026,12,31,23,59,0)" />
<NgDateInput Label="Locked date" Value="locked" ValueExpression="() => locked" Disabled />
</div>
<NgDateRangePicker ReadOnly="readOnly" DisabledDate="Sunday" Label="Room reservation" @bind-Value="model.Range" Min="min" Max="max" />
<div class="fields" style="margin-top:24px"><NgMultiSelect Label="Services" Items="services" @bind-Value="model.Services" MaxSelected="3" FilterMode="@filterMode" ReadOnly="choicesReadOnly" ShowActions><ItemTemplate Context="service"><strong>@service.Label</strong></ItemTemplate><TagTemplate Context="service">✓ @service.Label</TagTemplate></NgMultiSelect><div><NgCalendar ReadOnly="readOnly" Value="model.Date" ValueChanged="v => model.Date=v" Min="min" Max="max" DisabledDate="Sunday" /></div></div>
<NgTextArea Label="Notes" @bind-Value="model.Notes" MaxLength="500" ReadOnly="readOnly" HelperText="Share preparation details with the team." />
<div class="row actions" style="margin-top:24px"><NgButton Primary Type="submit">Save workshop</NgButton><NgButton OnClick="Reset">Reset example</NgButton></div>
</NgForm></section><footer class="page-footer">47 COMPONENTS <span>WEB FIRST / BLAZOR + FLUTTER</span></footer>
</main></div>
@code {
 private bool dark,compact,readOnly,fail,choicesReadOnly;private string filterMode="contains";private readonly NgOption[] filterModes=[new("contains","Contains"),new("startsWith","Starts with"),new("endsWith","Ends with")];
 private string? saved;
 private Booking model=new();
 private DateOnly? locked=new(2026,1,1);
 private DateOnly min=new(2026,1,1),max=new(2026,12,31);
 private static bool Sunday(DateOnly d)=>d.DayOfWeek==DayOfWeek.Sunday;
 private readonly string[] cities=["Kyiv","London","Lisbon","Berlin","Paris"];
 private readonly NgOption[] people=[new("alex","Alex Morgan"),new("jamie","Jamie Chen"),new("sam","Sam Rivera"),new("unavailable","Unavailable facilitator",true)];
 private readonly NgOption[] services=[new("room","Meeting room"),new("coffee","Coffee"),new("video","Video recording"),new("lunch","Lunch"),new("travel","Travel (unavailable)",true)];
 private async Task Save(){var draft=model;var denied=fail;var snapshot=$"{draft.Name} · {draft.City} · {draft.Person} · {draft.Date:yyyy-MM-dd} {draft.Time:HH:mm} · {draft.Range?.Start:yyyy-MM-dd} – {draft.Range?.End:yyyy-MM-dd} · {string.Join(", ",draft.Services)}";await Task.Delay(1200);if(denied)throw new InvalidOperationException("Demo failure");if(ReferenceEquals(model,draft))saved=snapshot;}
 private void Reset(){model=new();saved=null;}
 public sealed class Booking {
 [Required] public string? Name{get;set;}="Design workshop";
 public string? City{get;set;}="Kyiv";
 [Required] public string? Person{get;set;}="alex";
 [Required] public DateOnly? Deadline{get;set;}=new(2026,10,20);
 [Required] public DateOnly? Date{get;set;}=new(2026,10,22);
 [Required] public TimeOnly? Time{get;set;}=new(9,30);
 public DateTime? Reminder{get;set;}=new(2026,10,21,9,0,0);
 public NgDateRange? Range{get;set;}=new(new(2026,10,22),new(2026,10,23));
 [MinLength(1,ErrorMessage="Choose at least one service.")] public string[] Services{get;set;}=["room"];
 public string? Notes{get;set;}="Bring the latest design proposals.";
 }
}
