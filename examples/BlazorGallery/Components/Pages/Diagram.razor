@page "/diagram"
<PageTitle>Nextgen • Diagram</PageTitle>
<div class="ng-scope gallery" data-ng-theme="@(dark?"dark":"light")" data-ng-density="@(compact?"compact":"normal")"><main>
<nav><strong><span class="brand-icon">N</span> NEXTGEN COMPONENTS</strong><div class="row"><a href="/">Foundation</a><NgSwitch Label="Dark theme" @bind-Value="dark"/><NgCheckBox Label="Compact" @bind-Value="compact"/></div></nav>
<section class="hero"><p class="eyebrow">BLAZOR / DIAGRAMS 0.7</p><h1>Connect the steps.<br/>Explore the process.</h1><p>Move nodes, inspect connections and save a portable workflow.</p></section>
<section class="panel"><div class="row"><NgCheckBox Label="Read only" @bind-Value="readOnly"/><NgButton Disabled="@(readOnly||undo.Count==0)" OnClick="Undo">Undo change</NgButton><NgButton OnClick="Reset">Reset sample</NgButton></div><NgDiagram Label="Release workflow" Value="graph" ValueChanged="Apply" SelectedNodeId="@nodeId" SelectedNodeIdChanged="SelectNode" SelectedEdgeId="@edgeId" SelectedEdgeIdChanged="SelectEdge" ReadOnly="readOnly"/><p role="status">@Selection</p></section>
<section class="panel"><h3>Node properties</h3><div class="fields"><label class="ng-field">Node text<input class="ng-input" aria-label="Node text" @bind="nodeText" @bind:event="oninput" maxlength="100" disabled="@readOnly"/></label><label class="ng-field">Shape<select class="ng-input" aria-label="Shape" @bind="shape" disabled="@readOnly">@foreach(var s in Enum.GetValues<NgDiagramShape>()){<option value="@s">@s</option>}</select></label></div><div class="row"><NgButton Disabled="@readOnly" OnClick="AddNode">Add node</NgButton><NgButton Disabled="@(readOnly||nodeId is null)" OnClick="SaveNode">Save node</NgButton><NgButton Disabled="@(readOnly||(nodeId is null&&edgeId is null))" OnClick="Delete">Delete selected</NgButton></div><p>Deleting a node also removes its connections. Undo change restores the previous graph.</p></section>
<section class="panel"><h3>Connection properties</h3><div class="fields"><label class="ng-field">From<select class="ng-input" aria-label="From node" @bind="from" disabled="@readOnly"><option value="">Choose node</option>@foreach(var n in graph.Nodes){<option value="@n.Id">@n.Text</option>}</select></label><label class="ng-field">To<select class="ng-input" aria-label="To node" @bind="to" disabled="@readOnly"><option value="">Choose node</option>@foreach(var n in graph.Nodes){<option value="@n.Id">@n.Text</option>}</select></label><label class="ng-field">Connection text<input class="ng-input" aria-label="Connection text" @bind="edgeText" @bind:event="oninput" maxlength="100" disabled="@readOnly"/></label></div><NgCheckBox Label="Directed" @bind-Value="directed" Disabled="readOnly"/><div class="row"><NgButton Disabled="@readOnly" OnClick="()=>SaveEdge(true)">Add connection</NgButton><NgButton Disabled="@(readOnly||edgeId is null)" OnClick="()=>SaveEdge(false)">Save connection</NgButton></div></section>
<section class="panel"><h3>Save and restore</h3><div class="row"><NgButton OnClick="()=>source=graph.ToJson()">Export JSON</NgButton><NgButton Disabled="@readOnly" OnClick="Import">Import JSON</NgButton></div><label class="ng-field">Diagram source<textarea class="ng-input" aria-label="Diagram source" rows="6" @bind="source" @bind:event="oninput" maxlength="1000000"></textarea></label></section><p role="status">@status</p>
<footer class="page-footer">35 CONTROLS / 41 CATALOGUE ENTRIES <span>WEB FIRST</span></footer>
</main></div>
@code {
 private bool dark,compact,readOnly,directed=true;
 private NgDiagramModel graph=Sample();private readonly List<NgDiagramModel> undo=[];
 private string? nodeId,edgeId;private string nodeText="New step",from="",to="",edgeText="",source="",status="";private NgDiagramShape shape;
 private string Selection=>nodeId is not null?graph.Nodes.Where(n=>n.Id==nodeId).Select(n=>$"Selected {n.Id}: {n.Text} · X {n.X:0.#}, Y {n.Y:0.#}").FirstOrDefault()??"No selection":edgeId is not null?$"Selected connection {edgeId}":"No selection";
 private static NgDiagramModel Sample()=>new([new("draft","Draft",50,180,Shape:NgDiagramShape.Ellipse),new("review","Review",350,160,Height:120,Shape:NgDiagramShape.Diamond),new("release","Release",700,180,Shape:NgDiagramShape.Ellipse),new("revise","Revise",350,400)],[new("submit","draft","review","Submit"),new("approve","review","release","Approve"),new("changes","review","revise","Changes"),new("retry","revise","draft","Retry")]);
 private void Apply(NgDiagramModel next){if(readOnly)return;undo.Add(graph);if(undo.Count>20)undo.RemoveAt(0);graph=next;if(!graph.Nodes.Any(n=>n.Id==nodeId))nodeId=null;if(!graph.Edges.Any(e=>e.Id==edgeId))edgeId=null;if(!graph.Nodes.Any(n=>n.Id==from))from="";if(!graph.Nodes.Any(n=>n.Id==to))to="";status="Graph updated.";}
 private void Change(Func<NgDiagramModel> action){if(readOnly)return;try{Apply(action());}catch(ArgumentException e){status=e.Message;}}
 private void SelectNode(string? id){nodeId=id;if(id is null)return;var n=graph.Nodes.First(n=>n.Id==id);nodeText=n.Text;shape=n.Shape;}
 private void SelectEdge(string? id){edgeId=id;if(id is null)return;var e=graph.Edges.First(e=>e.Id==id);from=e.From;to=e.To;edgeText=e.Text;directed=e.Directed;}
 private string NewId(string prefix){var i=1;while(graph.Nodes.Any(n=>n.Id==$"{prefix}{i}")||graph.Edges.Any(e=>e.Id==$"{prefix}{i}"))i++;return $"{prefix}{i}";}
 private void AddNode(){var id=NewId("node");Change(()=>graph.UpsertNode(new(id,nodeText,40,40,Shape:shape)));if(graph.Nodes.Any(n=>n.Id==id)){edgeId=null;SelectNode(id);}}
 private void SaveNode(){if(nodeId is not null)Change(()=>graph.UpsertNode(graph.Nodes.First(n=>n.Id==nodeId) with {Text=nodeText,Shape=shape}));}
 private void SaveEdge(bool add){var id=add?NewId("edge"):edgeId;if(id is null)return;Change(()=>graph.UpsertEdge(new(id,from,to,edgeText,directed)));if(graph.Edges.Any(e=>e.Id==id)){nodeId=null;SelectEdge(id);}}
 private void Delete(){if(nodeId is not null)Change(()=>graph.RemoveNode(nodeId));else if(edgeId is not null)Change(()=>graph.RemoveEdge(edgeId));}
 private void Undo(){if(readOnly||undo.Count==0)return;graph=undo[^1];undo.RemoveAt(undo.Count-1);nodeId=edgeId=null;from=to="";status="Change undone.";}
 private void Reset(){graph=Sample();undo.Clear();nodeId=edgeId=null;from=to=source="";status="Sample restored.";}
 private void Import()=>Change(()=>NgDiagramModel.FromJson(source));
}
