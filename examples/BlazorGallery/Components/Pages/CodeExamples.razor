@using Microsoft.JSInterop
@page "/code-examples"
@using System.Text.Json
@inject IWebHostEnvironment Host
@inject IJSRuntime JS
<PageTitle>Nextgen • Code examples</PageTitle>
<div class="ng-scope gallery"><main>
<nav><strong>N NEXTGEN COMPONENTS</strong><div class="row"><a href="/">Foundation</a><a href="http://127.0.0.1:5182/docs/manual/getting-started.md" target="_blank" rel="noopener">Getting started</a><a href="http://127.0.0.1:5182/docs/manual/README.md" target="_blank" rel="noopener">Documentation</a></div></nav>
<section class="hero"><p class="eyebrow">DEVELOPER GUIDE</p><h1>Code examples.</h1><p>Working Blazor and Flutter snippets for every component. Use Getting started for installation and the complete application shell.</p></section>
<section class="panel"><label class="ng-field">Component<select class="ng-input" aria-label="Component" @bind="selected">@foreach(var item in examples){<option value="@item.Key">@item.Key — @item.Value.title</option>}</select></label>
<div class="row"><a href="@($"http://127.0.0.1:5182/docs/manual/{selected}.md")" target="_blank" rel="noopener">Full component manual</a><NgButton OnClick="Copy">Copy code</NgButton></div>
<NgRadioGroup Label="Framework" Items="frameworks" @bind-Value="framework"/>
<p>@(framework=="blazor"?"Place in an interactive Razor page with @using NextgenComponents.Blazor.":"Place fields and build method inside a State class with the Material and Nextgen imports.")</p>
<pre class="demo-code"><code>@foreach(var token in Tokens){<span class="@($"syntax-{token.kind}")">@token.text</span>}</code></pre><p role="status">@notice</p></section>
</main></div>
@code {
 private Dictionary<string,Example> examples=[];private string selected="NgWizard";private string? framework="blazor",notice;
 private NgOption[] frameworks=[new("blazor","Blazor"),new("flutter","Flutter")];
 private string Code=>examples.TryGetValue(selected,out var e)?framework=="blazor"?e.blazor:e.flutter:"";
 protected override void OnInitialized()=>examples=JsonSerializer.Deserialize<Dictionary<string,Example>>(File.ReadAllText(Path.Combine(Host.WebRootPath,"component-examples.json")))!;
 private async Task Copy(){try{await JS.InvokeVoidAsync("navigator.clipboard.writeText",Code);notice="Code copied.";}catch(JSException){notice="Select the code and copy it manually.";}}
 private Token[] Tokens=>examples.TryGetValue(selected,out var e)?framework=="blazor"?e.blazorTokens:e.flutterTokens:[];
 public sealed record Token(string kind,string text);
 public sealed record Example(string title,string blazor,string flutter,Token[] blazorTokens,Token[] flutterTokens);
}
