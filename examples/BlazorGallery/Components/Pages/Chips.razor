@page "/chips"
<PageTitle>Nextgen • Chips and tags</PageTitle>
<div class="ng-scope gallery" data-ng-theme="@(dark?"dark":"light")"><main>
<nav><a href="/code-examples">Code examples</a><strong>N NEXTGEN COMPONENTS</strong><div class="row"><a href="/">Foundation</a><NgSwitch Label="Dark theme" @bind-Value="dark"/></div></nav>
<section class="hero"><p class="eyebrow">BLAZOR / CHIPS 0.23</p><h1>Small tags.<br/>Clear choices.</h1><p>Select topics, remove a tag, or show a compact status. Your application owns every change.</p></section>
<section class="panel"><div class="row"><NgCheckBox Label="Disable controls" @bind-Value="disabled"/><NgCheckBox Label="Multiple selection" Value="multiple" ValueChanged="SetMultiple" ValueExpression="()=>multiple"/><NgCheckBox Label="Enable selection" @bind-Value="selectable"/><NgCheckBox Label="Protect Design from removal" @bind-Value="protect"/><NgButton OnClick="Reset">Reset tags</NgButton><NgButton OnClick="LoadCollection">Load 500 tags</NgButton></div>
<h2>Appearance and content</h2>
<div class="row"><NgDropDownList Label="Size" Items="sizes" @bind-Value="size"/><NgDropDownList Label="Rounded" Items="roundings" @bind-Value="rounded"/><NgDropDownList Label="Fill mode" Items="fills" @bind-Value="fill"/><NgCheckBox Label="Custom content" @bind-Value="custom"/></div>
<p>Templates can show an icon, avatar or custom text. The accessible name always comes from the label.</p>
<div class="row">@foreach(var tone in tones){<NgChip Label="@tone" Selectable="false" Size="@size" Rounded="@rounded" FillMode="@fill" ThemeColor="@tone"/>}</div>
<h2>Topics</h2><p>Keyboard: Tab enters once and leaves the list. Shift+Tab returns to the remembered chip. Left/Right, Home/End move focus. Enter/Space activates. Delete/Backspace requests removal. Disabled tags are skipped.</p><NgCheckBox Label="Custom action labels" @bind-Value="customLabels"/><NgChipList EmptyText="@(customLabels?"No topics available":"No tags")" RemoveLabel="@(customLabels?ActionLabel:null)" @ref="chipList" Label="Topics" Items="items" Value="selected" ValueChanged="SetSelected" OnRemove="Remove" Multiple="multiple" Disabled="disabled" Selectable="selectable" Size="@size" Rounded="@rounded" FillMode="@fill" CanRemove="CanRemove" ItemAppearance="Appearance" OnClick="id=>lastClick=id">
<LeadingTemplate Context="item">@if(custom){<span aria-hidden="true">★</span>}</LeadingTemplate>
<ItemTemplate Context="item">@if(custom){<strong>@item.Label <small>· @item.Label.Length</small></strong>}else{@item.Label}</ItemTemplate>
<RemoveContent>−</RemoveContent>
</NgChipList>
<NgButton OnClick="()=>chipList!.FocusAsync()">Focus topics</NgButton><NgButton OnClick="ClearTopics">Clear topics</NgButton><p id="chips-status" role="status">Selected: @(selected.Count==0?"none":string.Join(", ",selected)) · Tags: @items.Count · @message</p>
<p>Flutter is not removable. Last click: <span id="chip-click">@lastClick</span></p><h2>Status and standalone selection</h2><div class="row"><NgChip Id="published-chip" Label="Published" Selectable="false" AriaDescribedBy="published-help"/><NgChip Label="Favourite" @bind-Value="favourite" Disabled="disabled"/></div>
<p id="published-help">This status is read-only.</p><p id="activity-help">Opens the activity summary.</p><NgChip TabIndex="@(skipTab?-1:0)" Id="activity-chip" Class="activity-chip" AriaDescribedBy="activity-help" Label="Open activity" Selectable="false" OnClick="OpenActivity" Disabled="disabled"/><p>Removal is a request. Enable protection to reject removal of Design without changing the list.</p></section>
<section class="panel">
<h2 id="business-heading">@BusinessHeading</h2><p id="business-help">@BusinessHelp</p><NgButton OnClick="()=>updatedMetadata=!updatedMetadata">Update accessible text</NgButton><p>Bind model fields with typed selectors. Templates and events resolve the original record by its stable ID. Finance is pinned; Archive is disabled.</p>
<NgChipList Id="business-topics" Class="business-topics" AriaLabelledBy="business-heading" AriaDescribedBy="business-help" Label="Business topics" Items="businessData.Items" Value="businessSelected" ValueChanged="v=>businessSelected=v" Multiple CanRemove="businessData.CanRemove" ItemAppearance="businessData.GetAppearance" OnRemove="RemoveBusiness" OnClick="OpenBusiness">
<ItemTemplate Context="option">@businessData.GetItem(option.Value).Name <small>· @businessData.GetItem(option.Value).Owner</small></ItemTemplate>
</NgChipList>
<div class="row"><NgButton OnClick="RenameBusiness" Disabled="@(!records.Any(x=>x.Id=="ops"))">Rename Operations</NgButton><NgButton OnClick="ReverseBusiness">Reverse records</NgButton><NgButton OnClick="ResetBusiness">Reset records</NgButton></div>
<p id="business-status" role="status">@businessMessage</p>
</section>
<section class="panel" id="direction-example">
<h2>Reading direction</h2><p>The same collection inherits direction from its container. Start/end, icons and removal mirror together; Left/Right follow the reading direction. Home/End keep data order.</p>
<div class="row"><NgCheckBox Label="Right-to-left layout" @bind-Value="rtl"/><NgButton OnClick="ResetDirection">Reset direction example</NgButton></div>
<div class="row"><NgDropDownList Label="Tag gap" Items="gapOptions" @bind-Value="gap"/><NgCheckBox Label="Skip topics with Tab" @bind-Value="skipTab"/></div><p>Tab skips the list when enabled; mouse and Focus directional topics still work. Gap changes both columns and rows.</p><NgButton OnClick="()=>directionList!.FocusAsync()">Focus directional topics</NgButton>
<div dir="@(rtl?"rtl":"ltr")" style="max-width:420px;margin-block:16px">
<NgChipList @ref="directionList" Gap="@gap" TabIndex="@(skipTab?-1:0)" Label="Directional topics" Items="directionItems" Value="directionSelected" ValueChanged="v=>directionSelected=v" Multiple OnRemove="RemoveDirection" RemoveLabel="ActionLabel">
<LeadingTemplate><span aria-hidden="true">★</span></LeadingTemplate>
</NgChipList>
<NgChip Label="Pinned status" Selectable="false"><Leading><span aria-hidden="true">★</span></Leading></NgChip>
</div>
<NgButton OnClick="()=>{}">After topics</NgButton><p id="direction-status" role="status">Direction: @(rtl?"RTL":"LTR") · Selected: @string.Join(", ",directionSelected) · Tags: @directionItems.Count</p>
</section>
<footer>47 CONTROLS / 53 CATALOGUE ENTRIES · WEB FIRST</footer></main></div>
@code {
 private sealed record BusinessTopic(string Id,string Name,string Owner,bool Disabled=false,bool Pinned=false,string Tone="base");
 private static List<BusinessTopic> InitialRecords()=>[new("ops","Operations","Morgan",Tone:"warning"),new("finance","Finance","Alex",Pinned:true,Tone:"success"),new("archive","Archive","Sam",Disabled:true)];
 private List<BusinessTopic> records=InitialRecords();
 private IReadOnlyList<string> businessSelected=["finance"];
 private NgChipData<BusinessTopic> businessData=default!;
 private string businessMessage="3 model records · Finance selected";
 private static NgChipData<BusinessTopic> BindRecords(IEnumerable<BusinessTopic> source)=>new(source,x=>x.Id,x=>x.Name,disabled:x=>x.Disabled,removable:x=>!x.Pinned,appearance:x=>new(ThemeColor:x.Tone));
 protected override void OnInitialized()=>businessData=BindRecords(records);
 private void OpenBusiness(string id){var item=businessData.GetItem(id);businessMessage=$"Opened {item.Name} · owner {item.Owner}";}
 private void RemoveBusiness(string id){var item=businessData.GetItem(id);records=records.Where(x=>x.Id!=id).ToList();businessSelected=businessSelected.Where(x=>x!=id).ToArray();businessData=BindRecords(records);businessMessage=$"Removed {item.Name} · owner {item.Owner} · {records.Count} records";}
 private void RenameBusiness(){records=records.Select(x=>x.Id=="ops"?x with {Name="Operations revised"}:x).ToList();businessData=BindRecords(records);businessMessage="Model updated; IDs and selection retained";}
 private void ReverseBusiness(){records.Reverse();businessData=BindRecords(records);businessMessage="Model order reversed; IDs and selection retained";}
 private void ResetBusiness(){records=InitialRecords();businessSelected=["finance"];businessData=BindRecords(records);businessMessage="3 model records · Finance selected";}

 private bool updatedMetadata;
 private string BusinessHeading=>updatedMetadata?"Assigned business records":"Business records";
 private string BusinessHelp=>updatedMetadata?"Choose assigned topics for this workspace.":"Choose topics for this workspace.";
 private NgChipList? directionList;
 private string gap="md";private bool skipTab;
 private readonly NgOption[] gapOptions=Options("sm","md","lg");
 private bool rtl=true;
 private static NgOption[] DirectionItems()=>[new("design","Design systems"),new("locked","Locked topic",true),new("web","Web components"),new("docs","Documentation")];
 private IReadOnlyList<NgOption> directionItems=DirectionItems();
 private IReadOnlyList<string> directionSelected=["design"];
 private void RemoveDirection(string id){directionItems=directionItems.Where(x=>x.Value!=id).ToArray();directionSelected=directionSelected.Where(x=>x!=id).ToArray();}
 private void ResetDirection(){gap="md";skipTab=false;directionItems=DirectionItems();directionSelected=["design"];rtl=true;}
 private bool dark,disabled,protect,favourite,multiple=true,selectable=true;
 private NgChipList? chipList;
 private bool CanRemove(NgOption item)=>item.Value!="flutter";
 private NgChipAppearance Appearance(NgOption item)=>new(ThemeColor:item.Value=="design"?"info":"base");
 private void OpenActivity()=>lastClick="activity";
 private bool custom,customLabels;
 private string ActionLabel(NgOption item)=>$"Dismiss {item.Label}";
 private void ClearTopics(){items=[];selected=[];message="Topics cleared";}
 private string size="md",rounded="full",fill="outline",lastClick="none";
 private static NgOption[] Options(params string[] values)=>values.Select(x=>new NgOption(x,x)).ToArray();
 private readonly NgOption[] sizes=Options("sm","md","lg"),roundings=Options("sm","md","lg","full"),fills=Options("solid","outline");
 private readonly string[] tones=["base","info","success","warning","error"];
 private string message="Ready";
 private IReadOnlyList<NgOption> items=Initial();private IReadOnlyList<string> selected=["design"];
 private static NgOption[] Initial()=>[new("design","Design"),new("web","Web"),new("flutter","Flutter"),new("locked","Locked",true)];
 private void SetSelected(IReadOnlyList<string> value){selected=value;message="Selection updated";}
 private void SetMultiple(bool value){multiple=value;if(!value)selected=selected.Take(1).ToArray();}
 private void Remove(string id){if(protect&&id=="design"){message="Design is protected";return;}items=items.Where(x=>x.Value!=id).ToArray();selected=selected.Where(x=>x!=id).ToArray();message=$"Removed {id}";}
 private void LoadCollection(){items=Enumerable.Range(1,500).Select(i=>new NgOption($"tag{i}",$"Topic {i:D3}",i%10==0)).ToArray();selected=["tag1"];multiple=true;message="500 tags loaded; every tenth tag is disabled";}
 private void Reset(){items=Initial();selected=["design"];message="Tags restored";favourite=false;}
}
