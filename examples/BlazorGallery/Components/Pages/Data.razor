@page "/data"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
<PageTitle>Nextgen • Data workspace</PageTitle>
<div class="ng-scope gallery" data-ng-theme="@(dark?"dark":"light")" data-ng-density="@(compact?"compact":"normal")"><main>
<nav><a href="/code-examples">Code examples</a><strong><span class="brand-icon">N</span> NEXTGEN COMPONENTS</strong><div class="row"><a href="/">Foundation</a><a href="/forms">Forms and dates</a><NgSwitch Label="Dark theme" @bind-Value="dark"/><NgCheckBox Label="Compact" @bind-Value="compact"/></div></nav>
<section class="hero"><p class="eyebrow">BLAZOR / DATA WORKSPACE 0.44</p><h1>Find the detail.<br/>Keep the context.</h1><p>Explore projects by team, sort budgets, select across pages and edit a project. All changes stay in this example.</p></section>
<NgBreadcrumb Items="Crumbs" OnNavigate="ChooseFolder" />
<div class="workspace-layout"><aside class="panel"><h2>Teams</h2><NgTreeView TItem="string" Items="folders" Text="x=>x" SelectedId="folder" SelectedIdChanged="ChooseFolder" @bind-ExpandedIds="folderExpanded" /></aside>
<section class="panel workspace-main"><div class="panel-heading"><h2>@FolderName</h2><span class="tag">@Projects.Count PROJECTS</span></div>
@if(saved is not null){<p role="status" class="data-notice">@saved</p>}
<NgDataGrid @key="folder" TItem="Project" Items="Projects" Columns="columns" RowId="p=>p.Id" Label="Projects" @bind-SelectedIds="selected" CanSelect="CanSelectProject" SelectionReadOnly="selectionReadOnly" PageSizes="new[]{5,10,18}">
<Toolbar><NgCheckBox Label="Selection read-only" @bind-Value="selectionReadOnly"/><NgButton Disabled="@(selectionReadOnly || selected.All(id=>projects.Any(p=>p.Id==id && p.Status=="Paused")))" OnClick="ClearSelection">Clear selectable</NgButton></Toolbar>
<EmptyTemplate><strong>No projects found.</strong> Try another search.</EmptyTemplate>
<RowActions Context="project"><NgButton aria-label="@($"Edit {project.Name}")" OnClick="()=>Edit(project)">Edit</NgButton></RowActions>
</NgDataGrid>
<p class="data-hint">Paused projects are protected. Selection follows project IDs across sorting and pages. Click a column heading to reverse sorting.</p>
</section></div>
<section class="panel"><div class="panel-heading"><h2>Portfolio hierarchy</h2><span class="tag">TREELIST</span></div>
<div class="row"><NgCheckBox Label="Tree selection read-only" @bind-Value="treeSelectionReadOnly"/><NgCheckBox Label="Tree expansion read-only" @bind-Value="treeExpansionReadOnly"/></div>
<NgTreeList SelectionReadOnly="treeSelectionReadOnly" ExpansionReadOnly="treeExpansionReadOnly" TItem="Project" Items="Hierarchy" Columns="treeColumns" @bind-ExpandedIds="portfolioExpanded" @bind-SelectedId="portfolioSelection" Label="Portfolio" />
<p role="status">Selected node: @(portfolioSelection??"none")</p></section>
<footer class="page-footer">27 COMPONENTS <span>WEB FIRST / BLAZOR + FLUTTER</span></footer>
<NgDialog Title="Edit project" @bind-Open="editing"><ChildContent>@if(draft is not null){<NgForm @key="draft" Model="draft" OnValidSubmit="Save"><div class="fields"><NgTextBox Label="Project name" @bind-Value="draft.Name"/><NgTextBox Label="Owner" @bind-Value="draft.Owner"/><NgNumericTextBox Label="Budget" @bind-Value="draft.Budget" Min="0" Max="1000000"/><NgDropDownList Label="Status" Items="statuses" @bind-Value="draft.Status"/></div><div class="row"><NgButton Primary Type="submit">Save project</NgButton><NgButton OnClick="()=>editing=false">Cancel</NgButton></div></NgForm>}</ChildContent></NgDialog>
</main></div>
@code {
 private bool dark,compact,editing,selectionReadOnly,treeSelectionReadOnly,treeExpansionReadOnly;
 private static bool CanSelectProject(Project p)=>p.Status!="Paused";
 private void ClearSelection(){if(!selectionReadOnly)selected=selected.Where(id=>projects.Any(p=>p.Id==id && p.Status=="Paused")).ToHashSet();}
 private string? folder="all",saved,portfolioSelection;
 private HashSet<string> selected=[],folderExpanded=["all"],portfolioExpanded=["design"];
 private Project? draft;
 private List<Project> projects=Enumerable.Range(1,18).Select(i=>new Project{Id=$"P{i:000}",Name=new[]{"Design system","Web portal","Mobile shell","Research hub","Release tools","Client workspace"}[(i-1)%6]+$" {i:00}",Team=new[]{"design","platform","operations"}[(i-1)%3],Owner=new[]{"Alex Morgan","Jamie Chen","Sam Rivera"}[(i-1)%3],Budget=new decimal[]{120,9000,450,12000,75,2400}[(i-1)%6],Status=i%4==0?"Paused":"Active"}).ToList();
 private readonly NgTreeNode<string>[] folders=[new("all","All projects",[new("design","Design"),new("platform","Platform"),new("operations","Operations"),new("archive","Archive",Disabled:true)])];
 private readonly NgOption[] statuses=[new("Active","Active"),new("Paused","Paused"),new("Completed","Completed")];
 private static string Money(Project p)=>$"${p.Budget??0:N0}";
 private readonly NgDataColumn<Project>[] columns=[new("id","ID",p=>p.Id),new("name","Project",p=>p.Name),new("owner","Owner",p=>p.Owner),new("budget","Budget",p=>p.Budget,Format:Money),new("status","Status",p=>p.Status)];
 private readonly NgDataColumn<Project>[] treeColumns=[new("name","Project / team",p=>p.Name),new("owner","Owner",p=>p.Owner),new("budget","Budget",p=>p.Budget,Format:Money),new("status","Status",p=>p.Status)];
 private List<Project> Projects=>projects.Where(p=>folder=="all"||p.Team==folder).ToList();
 private string FolderName=>folder switch{"design"=>"Design","platform"=>"Platform","operations"=>"Operations",_=>"All projects"};
 private IReadOnlyList<NgBreadcrumbItem> Crumbs=>folder=="all"?[new("all","All projects")]:[new("all","All projects"),new(folder!,FolderName)];
 private IReadOnlyList<NgTreeNode<Project>> Hierarchy=>new[]{"design","platform","operations"}.Select(team=>new NgTreeNode<Project>(team,new Project{Id=team,Name=char.ToUpper(team[0])+team[1..],Owner="Team",Budget=projects.Where(p=>p.Team==team).Sum(p=>p.Budget),Status="Portfolio"},projects.Where(p=>p.Team==team).Select(p=>new NgTreeNode<Project>(p.Id,p)).ToArray())).ToArray();
 private void ChooseFolder(string? id){if(id is null||id=="archive")return;folder=id;selected=[];}
 private void Edit(Project p){draft=new(){Id=p.Id,Name=p.Name,Owner=p.Owner,Budget=p.Budget,Status=p.Status,Team=p.Team};editing=true;}
 private void Save(){if(draft is null)return;projects=projects.Select(p=>p.Id==draft.Id?draft:p).ToList();saved=$"Saved {draft.Id}: {draft.Name} · {Money(draft)} · {draft.Status}";editing=false;}
 public sealed class Project {
 public string Id{get;set;}="";public string Team{get;set;}="";
 [Required] public string? Name{get;set;}
 [Required] public string? Owner{get;set;}
 [Required,Range(0,1000000)] public decimal? Budget{get;set;}
 public string Status{get;set;}="Active";
 }
}
