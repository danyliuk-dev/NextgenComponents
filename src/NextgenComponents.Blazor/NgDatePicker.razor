@using System.Linq.Expressions
<div class="ng-date-picker" @onkeydown="KeyDown">
    <NgDateInput @ref="input" Id="@Id" Label="@Label" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" Min="Min" Max="Max" DisabledDate="DisabledDate" Disabled="Disabled" />
    <button @ref="trigger" type="button" class="ng-button ng-picker-trigger" disabled="@Disabled" aria-label="@($"Choose {Label}")" aria-expanded="@(open ? "true" : "false")" aria-controls="@(Id+"-calendar")" @onclick="() => open=!open">▦</button>
    @if(open && !Disabled) {
        <div class="ng-picker-panel" role="dialog" id="@(Id+"-calendar")" aria-label="@($"Choose {Label}")">
            <NgCalendar Value="Value" ValueChanged="Selected" Min="Min" Max="Max" DisabledDate="DisabledDate" />
            <div class="ng-picker-actions"><NgButton OnClick="() => Selected(null)">Clear</NgButton><NgButton OnClick="Close">Close</NgButton></div>
        </div>
    }
</div>
@code {
    [Parameter] public string Id { get; set; } = "ng-"+Guid.NewGuid().ToString("N");
    [Parameter] public string Label { get; set; } = "Date";
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<DateOnly?>>? ValueExpression { get; set; }
    [Parameter] public DateOnly? Min { get; set; }
    [Parameter] public DateOnly? Max { get; set; }
    [Parameter] public Func<DateOnly,bool>? DisabledDate { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private bool open;
    private NgDateInput? input;
    private ElementReference trigger;
    private async Task Selected(DateOnly? date) { input?.SetDate(date); await Close(); }
    private async Task Close() { open=false; await trigger.FocusAsync(); }
    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
