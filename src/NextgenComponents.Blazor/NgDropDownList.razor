@inherits InputBase<string>
<div class="ng-field">
<label for="@Id">@Label</label>
<select @attributes="AdditionalAttributes" id="@Id" class="ng-input @CssClass" value="@CurrentValueAsString" @onchange="Changed" disabled="@(Disabled || ReadOnly)" aria-describedby="@Description" aria-invalid="@(error is not null ? "true" : null)">
@if (Placeholder is not null) { <option value="" selected="@(string.IsNullOrEmpty(Value))">@Placeholder</option> }
@if (!string.IsNullOrEmpty(Value) && !Items.Any(o => o.Value == Value)) { <option value="@Value" selected disabled>Unavailable selection: @Value</option> }
else if (string.IsNullOrEmpty(Value) && Placeholder is null) { <option value="" selected disabled>Select an option</option> }
@foreach (var option in Items) { <option value="@option.Value" selected="@(option.Value == Value)" disabled="@option.Disabled">@option.Label</option> }
</select>
@if (HelperText is not null) { <small id="@(Id+"-help")">@HelperText</small> }
@if (error is not null) { <span id="@(Id+"-error")" class="ng-field-error" role="status">@error</span> }
</div>
@code {
 [Parameter] public string Id { get; set; } = "ng-" + Guid.NewGuid().ToString("N");
 [Parameter] public string Label { get; set; } = "";
 [Parameter] public string? Placeholder { get; set; }
 [Parameter] public string? HelperText { get; set; }
 [Parameter] public IReadOnlyList<NgOption> Items { get; set; } = [];
 [Parameter] public bool Disabled { get; set; }
 [Parameter] public bool ReadOnly { get; set; }
 private string? error;
 private string Description => string.Join(" ", new[]{AdditionalAttributes?.GetValueOrDefault("aria-describedby")?.ToString(), HelperText is null ? null : Id+"-help",error is null ? null : Id+"-error"}.Where(x => !string.IsNullOrWhiteSpace(x)));
 protected override void OnParametersSet() {
  base.OnParametersSet(); NgFilterRules.ValidateItems(Items);
  var missing=!string.IsNullOrEmpty(Value) && !Items.Any(o => o.Value == Value);
  if (missing != (error is not null)) CurrentValueAsString=Value;
 }
 private void Changed(ChangeEventArgs e) {
  if (Disabled || ReadOnly) return;
  var next=e.Value?.ToString() ?? "";
  if (Items.Any(o => o.Value == next && o.Disabled)) return;
  CurrentValueAsString=next;
 }
 protected override bool TryParseValueFromString(string? value, out string result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage) {
  result=value ?? "";
  error=!string.IsNullOrEmpty(value) && !Items.Any(o => o.Value == value) ? "Choose an available option." : null;
  validationErrorMessage=error; return error is null;
 }
}
