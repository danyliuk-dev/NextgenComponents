<label class="ng-field" for="@Id">@Label
<InputSelect @attributes="AdditionalAttributes" id="@Id" class="ng-input" TValue="string" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" disabled="@Disabled">
@if (Placeholder is not null) { <option value="">@Placeholder</option> }
@foreach (var option in Items) { <option value="@option.Value" disabled="@option.Disabled">@option.Label</option> }
</InputSelect></label>
@code {
 [Parameter] public string Id { get; set; } = "ng-" + Guid.NewGuid().ToString("N");
 [Parameter] public string Label { get; set; } = "";
 [Parameter] public string? Placeholder { get; set; }
 [Parameter] public IReadOnlyList<NgOption> Items { get; set; } = [];
 [Parameter] public string Value { get; set; } = "";
 [Parameter] public EventCallback<string> ValueChanged { get; set; }
 [Parameter] public System.Linq.Expressions.Expression<Func<string>>? ValueExpression { get; set; }
 [Parameter] public bool Disabled { get; set; }
 [Parameter(CaptureUnmatchedValues=true)] public Dictionary<string,object>? AdditionalAttributes { get; set; }
}
