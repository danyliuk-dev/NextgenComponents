<fieldset style="display:block" class="ng-radio-group" disabled="@(Disabled || ReadOnly)"><legend>@Label</legend>
<InputRadioGroup TValue="string" Value="Value" ValueChanged="Changed" ValueExpression="ValueExpression">
<div style="display:flex;flex-wrap:wrap;gap:12px;flex-direction:@(Orientation == "vertical" ? "column" : "row")">
@foreach (var item in Items) { <label class="ng-check"><InputRadio Value="item.Value" disabled="@item.Disabled" aria-label="@item.Label" />@if(ItemTemplate is null) { @item.Label } else { <span aria-hidden="true">@ItemTemplate(item)</span> }</label> }
</div></InputRadioGroup>
@if(HelperText is not null) { <small style="display:block;margin-top:6px">@HelperText</small> }
</fieldset>
@code {
 [Parameter] public string Label { get; set; } = "";
 [Parameter] public IReadOnlyList<NgOption> Items { get; set; } = [];
 [Parameter] public string Value { get; set; } = "";
 [Parameter] public EventCallback<string> ValueChanged { get; set; }
 [Parameter] public System.Linq.Expressions.Expression<Func<string>>? ValueExpression { get; set; }
 [Parameter] public string Orientation { get; set; } = "horizontal";
 [Parameter] public string? HelperText { get; set; }
 [Parameter] public RenderFragment<NgOption>? ItemTemplate { get; set; }
 [Parameter] public bool ReadOnly { get; set; }
 protected override void OnParametersSet() { NgFilterRules.ValidateItems(Items); if(Orientation is not ("horizontal" or "vertical")) throw new ArgumentException("Orientation must be horizontal or vertical."); }
 private Task Changed(string value) => Disabled || ReadOnly || !Items.Any(o=>o.Value==value && !o.Disabled) ? Task.CompletedTask : ValueChanged.InvokeAsync(value);
 [Parameter] public bool Disabled { get; set; }
}
