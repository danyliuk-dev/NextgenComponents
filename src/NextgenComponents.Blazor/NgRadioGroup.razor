<fieldset class="ng-radio-group" disabled="@Disabled"><legend>@Label</legend>
<InputRadioGroup TValue="string" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression">
@foreach (var item in Items) { <label class="ng-check"><InputRadio Value="item.Value" disabled="@item.Disabled" />@item.Label</label> }
</InputRadioGroup></fieldset>
@code {
 [Parameter] public string Label { get; set; } = "";
 [Parameter] public IReadOnlyList<NgOption> Items { get; set; } = [];
 [Parameter] public string Value { get; set; } = "";
 [Parameter] public EventCallback<string> ValueChanged { get; set; }
 [Parameter] public System.Linq.Expressions.Expression<Func<string>>? ValueExpression { get; set; }
 [Parameter] public bool Disabled { get; set; }
}
