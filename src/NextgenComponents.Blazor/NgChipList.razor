@implements IAsyncDisposable
@inject IJSRuntime JS
<div id="@Id" class="ng-chip-list ng-chip-gap-@Gap @Class" data-chip-tab-index="@TabIndex" role="@(UseListbox?"listbox":"group")" aria-orientation="@(UseListbox?"horizontal":null)" aria-multiselectable="@(UseListbox&&Multiple?"true":null)" aria-label="@Label" aria-labelledby="@AriaLabelledBy" aria-describedby="@AriaDescribedBy" tabindex="-1" @ref="root">
<CascadingValue Name="NextgenChipListOption" Value="UseListbox">
@foreach(var item in Items){
 var appearance=ItemAppearance?.Invoke(item);
 <span @key="item.Value" data-chip-id="@item.Value"><NgChip TabIndex="-1" Label="@item.Label" Value="@(selectedIds.Contains(item.Value))" Selectable="Selectable" Disabled="@(Disabled||item.Disabled)"
 Size="@(appearance?.Size??Size)" Rounded="@(appearance?.Rounded??Rounded)" FillMode="@(appearance?.FillMode??FillMode)" ThemeColor="@(appearance?.ThemeColor??ThemeColor)"
 Leading="@(LeadingTemplate is null?null:LeadingTemplate(item))" ChildContent="@(ItemTemplate is null?null:ItemTemplate(item))" RemoveContent="RemoveContent" RemoveLabel="@(RemoveLabel?.Invoke(item))"
 ValueChanged="@(ValueChanged.HasDelegate?EventCallback.Factory.Create<bool>(this,_=>Select(item.Value)):default)"
 OnClick="@(OnClick.HasDelegate?EventCallback.Factory.Create(this,()=>OnClick.InvokeAsync(item.Value)):default)"
 OnRemove="@(OnRemove.HasDelegate&&(CanRemove?.Invoke(item)??true)?EventCallback.Factory.Create(this,()=>Remove(item.Value)):default)"/></span>
}
</CascadingValue>
@if(Items.Count==0){<span class="ng-muted">@EmptyText</span>}
</div>
@code {
 private bool UseListbox => Selectable && !OnRemove.HasDelegate;
 [Parameter] public int TabIndex {get;set;}
 [Parameter] public string Gap {get;set;}="md";

 [Parameter] public string? Id {get;set;}
 [Parameter] public string? Class {get;set;}
 [Parameter] public string? AriaLabelledBy {get;set;}
 [Parameter] public string? AriaDescribedBy {get;set;}

 [Parameter] public string EmptyText {get;set;}="No tags";
 [Parameter] public Func<NgOption,string>? RemoveLabel {get;set;}
 [Parameter] public string Label {get;set;}="Tags";
 [Parameter,EditorRequired] public IReadOnlyList<NgOption> Items {get;set;}=[];
 [Parameter] public IReadOnlyList<string> Value {get;set;}=[];
 [Parameter] public EventCallback<IReadOnlyList<string>> ValueChanged {get;set;}
 [Parameter] public EventCallback<string> OnRemove {get;set;}
 [Parameter] public EventCallback<string> OnClick {get;set;}
 [Parameter] public bool Selectable {get;set;}=true;
 [Parameter] public bool Multiple {get;set;}
 [Parameter] public bool AllowEmpty {get;set;}=true;
 [Parameter] public bool Disabled {get;set;}
 [Parameter] public string Size {get;set;}="md";
 [Parameter] public string Rounded {get;set;}="full";
 [Parameter] public string FillMode {get;set;}="outline";
 [Parameter] public string ThemeColor {get;set;}="base";
 [Parameter] public Func<NgOption,NgChipAppearance>? ItemAppearance {get;set;}
 [Parameter] public Func<NgOption,bool>? CanRemove {get;set;}
 [Parameter] public RenderFragment<NgOption>? ItemTemplate {get;set;}
 [Parameter] public RenderFragment<NgOption>? LeadingTemplate {get;set;}
 [Parameter] public RenderFragment? RemoveContent {get;set;}
 protected override void OnParametersSet(){NgChipRules.ValidateTabIndex(TabIndex);NgChipRules.GapPixels(Gap);NgChipRules.ValidateAccessibility(Id,AriaLabelledBy,AriaDescribedBy);if(string.IsNullOrWhiteSpace(EmptyText))throw new ArgumentException("EmptyText must be nonblank.");NgSelectionRules.Validate(Items,Value,Multiple,maxItems:null);selectedIds=Value.ToHashSet(StringComparer.Ordinal);NgChipRules.Validate(Size,Rounded,FillMode,ThemeColor);}
 private HashSet<string> selectedIds=[];
 private Task Select(string id){if(Disabled||!Selectable)return Task.CompletedTask;var next=NgSelectionRules.Toggle(Items,Value,id,Multiple,AllowEmpty,maxItems:null);return next.SequenceEqual(Value)?Task.CompletedTask:ValueChanged.InvokeAsync(next);}
 private bool removing,disposed;private ElementReference root;private IJSObjectReference? module;
 private async Task Remove(string id){if(removing||Disabled||!Items.Any(x=>x.Value==id&&!x.Disabled&&(CanRemove?.Invoke(x)??true)))return;removing=true;try{await OnRemove.InvokeAsync(id);}finally{removing=false;}}
 public async Task FocusAsync(){if(module is not null&&!disposed)await module.InvokeVoidAsync("focus",root);}
 protected override async Task OnAfterRenderAsync(bool firstRender){if(disposed)return;module??=await JS.InvokeAsync<IJSObjectReference>("import","./_content/NextgenComponents.Blazor/chips.js");await module.InvokeVoidAsync("bind",root);}
 public async ValueTask DisposeAsync(){disposed=true;if(module is not null){try{await module.InvokeVoidAsync("dispose",root);await module.DisposeAsync();}catch(JSDisconnectedException){}catch(TaskCanceledException){}}}
}
