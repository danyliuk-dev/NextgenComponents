@inject IJSRuntime JS
<div class="ng-tabs" @ref="element">
<div role="tablist" aria-label="@Label">
@for (var i=0; i<Items.Count; i++) { var index=i; var tab=Items[i];
<button type="button" role="tab" id="@($"{id}-tab-{i}")" aria-controls="@($"{id}-panel-{i}")" aria-selected="@(SelectedIndex == i ? "true" : "false")" tabindex="@(SelectedIndex == i ? 0 : -1)" disabled="@tab.Disabled" @onclick="() => SelectedIndexChanged.InvokeAsync(index)">@tab.Label</button>
}
</div>
@for (var i=0; i<Items.Count; i++) {
<div role="tabpanel" id="@($"{id}-panel-{i}")" aria-labelledby="@($"{id}-tab-{i}")" hidden="@(SelectedIndex != i)" tabindex="0">@Items[i].Content</div>
}
</div>
@code {
 [Parameter] public string Label { get; set; } = "Tabs";
 [Parameter] public IReadOnlyList<NgTab> Items { get; set; } = [];
 [Parameter] public int SelectedIndex { get; set; }
 [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }
 private readonly string id = "ng-" + Guid.NewGuid().ToString("N");
 private ElementReference element;
 protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/NextgenComponents.Blazor/nextgen.js"); await module.InvokeVoidAsync("tabs", element); await module.DisposeAsync(); } }
}
