@using System.Text.Json
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
<section class="ng-map" aria-label="@Label"><h3>@Label</h3><iframe @ref="frame" src="@Navigation.ToAbsoluteUri("_content/NextgenComponents.Blazor/map-viewer/index.html")" title="@Label" style="@($"width:100%;height:{Height}px;border:1px solid var(--ng-border,#888);border-radius:4px")"></iframe></section>
@code {
 [Parameter] public string Label {get;set;}="Map";
 [Parameter] public NgMapModel Value {get;set;}=new();
 [Parameter] public NgMapView View {get;set;}=new();
 [Parameter] public EventCallback<NgMapView> ViewChanged {get;set;}
 [Parameter] public string? SelectedId {get;set;}
 [Parameter] public EventCallback<string?> SelectedIdChanged {get;set;}
 [Parameter] public EventCallback<NgMapPoint> OnMapClick {get;set;}
 [Parameter] public string? TileUrlTemplate {get;set;}
 [Parameter] public string Attribution {get;set;}="";
 [Parameter] public string? AttributionUrl {get;set;}
 [Parameter] public bool ClusterMarkers {get;set;}
 [Parameter] public int ClusterRadius {get;set;}=60;
 [Parameter] public bool Dark {get;set;}
 [Parameter] public bool NavigationReadOnly {get;set;}
 [Parameter] public bool SelectionReadOnly {get;set;}
 [Parameter] public bool MapClickReadOnly {get;set;}
 [Parameter] public string EmptyText {get;set;}="No objects";
 private long revision; private bool disposed;
 [Parameter] public int Height {get;set;}=520;
 private ElementReference frame; private IJSObjectReference? module; private DotNetObjectReference<NgMap>? reference; private string config="",sent="";
 private string? Resolve(string? url){if(string.IsNullOrWhiteSpace(url))return null;var uri=Navigation.ToAbsoluteUri(url);if(uri.Scheme is not ("http" or "https"))throw new ArgumentException("Map URLs must be relative or HTTP(S).");return uri.ToString();}
 protected override void OnParametersSet(){
  revision++;
  if(ClusterRadius<20||ClusterRadius>120)throw new ArgumentOutOfRangeException(nameof(ClusterRadius));
  ArgumentNullException.ThrowIfNull(Value);ArgumentNullException.ThrowIfNull(View);
  if(Height<400||Height>1200)throw new ArgumentOutOfRangeException(nameof(Height));
  if(!string.IsNullOrWhiteSpace(TileUrlTemplate)&&(!new[]{"{z}","{x}","{y}"}.All(TileUrlTemplate.Contains)||string.IsNullOrWhiteSpace(Attribution)))throw new ArgumentException("Tile URL needs {z}, {x}, {y} and visible attribution.");
  config=JsonSerializer.Serialize(new{revision,navigationReadOnly=NavigationReadOnly,selectionEnabled=!SelectionReadOnly&&SelectedIdChanged.HasDelegate,clickEnabled=!MapClickReadOnly&&OnMapClick.HasDelegate,controlledView=ViewChanged.HasDelegate,EmptyText,model=Value,view=View,SelectedId,ClusterMarkers,ClusterRadius,tileUrlTemplate=Resolve(TileUrlTemplate),Attribution,attributionUrl=Resolve(AttributionUrl),Dark},new JsonSerializerOptions{PropertyNamingPolicy=JsonNamingPolicy.CamelCase});
 }
 protected override async Task OnAfterRenderAsync(bool first){if(first){module=await JS.InvokeAsync<IJSObjectReference>("import","./_content/NextgenComponents.Blazor/map-bridge.js");if(disposed){await module.DisposeAsync();return;}reference=DotNetObjectReference.Create(this);await module.InvokeVoidAsync("attach",frame,reference);}if(module is not null&&sent!=config){var payload=config;await module.InvokeVoidAsync("update",frame,payload);sent=payload;}}
 [JSInvokable] public async Task MapEvent(string json){
  if(disposed)return;
  string? kind,id=null;NgMapPoint? point=null;NgMapView? view=null;
  try{
   using var doc=JsonDocument.Parse(json);var e=doc.RootElement;
   if(e.GetProperty("revision").GetInt64()!=revision)return;
   kind=e.GetProperty("kind").GetString();
   if(kind=="selection")id=e.GetProperty("id").GetString();
   else if(kind=="view")view=new(e.GetProperty("latitude").GetDouble(),e.GetProperty("longitude").GetDouble(),e.GetProperty("zoom").GetInt32());
   else if(kind=="click")point=new(e.GetProperty("latitude").GetDouble(),e.GetProperty("longitude").GetDouble());
  }catch(Exception e)when(e is JsonException or InvalidOperationException or KeyNotFoundException or ArgumentException or FormatException or OverflowException){return;}
  switch(kind){
   case "selection":if(!SelectionReadOnly&&SelectedIdChanged.HasDelegate&&(id is null||Value.Markers.Any(m=>m.Id==id)||Value.Paths.Any(p=>p.Id==id)))await SelectedIdChanged.InvokeAsync(id);break;
   case "view":if(!NavigationReadOnly&&ViewChanged.HasDelegate)await ViewChanged.InvokeAsync(view!);break;
   case "click":if(!MapClickReadOnly&&OnMapClick.HasDelegate)await OnMapClick.InvokeAsync(point!);break;
  }
 }
 public async ValueTask DisposeAsync(){disposed=true;revision++;try{if(module is not null){await module.InvokeVoidAsync("detach",frame);await module.DisposeAsync();}}catch(JSDisconnectedException){}reference?.Dispose();}
}
