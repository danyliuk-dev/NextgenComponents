@implements IAsyncDisposable
@inject IJSRuntime JS
@using System.Globalization
@{var renderedRevision=revision;}
<section class="ng-diagram" aria-label="@Label">
<h3>@Label</h3>
<div class="ng-diagram-toolbar" role="group" aria-label="Diagram navigation">
<NgButton OnClick="()=>ZoomBy(-.25)" Disabled="@(zoom<=.25)">Zoom out</NgButton><strong>@($"{zoom:P0}")</strong><NgButton OnClick="()=>ZoomBy(.25)" Disabled="@(zoom>=2)">Zoom in</NgButton><NgButton OnClick="Fit">Fit width</NgButton><NgButton OnClick="FitDiagram" Disabled="@(Value.Nodes.Count==0)">Fit diagram</NgButton><NgButton OnClick="()=>ZoomBy(1-zoom)">100%</NgButton>
</div>
<p>Choose a node or connection. Drag a node to move it; Escape cancels. Arrow keys move a focused node by 10 (Shift: 1). Scroll to explore.</p>
<div class="ng-diagram-viewport" @ref="viewport" tabindex="0" aria-label="Diagram scroll area">
<svg @ref="svg" xmlns="http://www.w3.org/2000/svg" width="@F(Value.Width*zoom)" height="@F(Value.Height*zoom)" viewBox="@($"0 0 {F(Value.Width)} {F(Value.Height)}")" role="group" aria-label="@Label" data-readonly="@(!Writable?"true":"false")" data-revision="@revision">
<defs><marker id="@marker" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,0 L10,4 L0,8 Z" class="ng-diagram-arrow"/></marker></defs>
@foreach(var e in Value.Edges){var line=Value.Line(e);var text=EdgeText(e);<g class="ng-diagram-edge @(SelectedEdgeId==e.Id?"ng-selected":"")" role="button" tabindex="0" aria-disabled="@(!CanSelectEdge?"true":"false")" aria-label="@($"Connection {text}: {e.From} to {e.To}")" aria-pressed="@(SelectedEdgeId==e.Id?"true":"false")" @onclick="()=>SelectEdge(e.Id,renderedRevision)" @onkeydown="k=>EdgeKey(k,e.Id,renderedRevision)"><title>@text: @e.From → @e.To</title><line x1="@F(line.Start.X)" y1="@F(line.Start.Y)" x2="@F(line.End.X)" y2="@F(line.End.Y)" class="ng-diagram-hit"/><line x1="@F(line.Start.X)" y1="@F(line.Start.Y)" x2="@F(line.End.X)" y2="@F(line.End.Y)" marker-end="@(e.Directed?$"url(#{marker})":null)"/>@if(text.Length>0){<g><text x="@F((line.Start.X+line.End.X)/2)" y="@F((line.Start.Y+line.End.Y)/2-8)" text-anchor="middle">@Short(text,24)</text></g>}</g>}
@foreach(var n in Value.Nodes){var text=NodeText(n);<g @key="n.Id" data-node="@n.Id" data-x="@F(n.X)" data-y="@F(n.Y)" data-width="@F(n.Width)" data-height="@F(n.Height)" transform="@($"translate({F(n.X)} {F(n.Y)})")" class="ng-diagram-node @(SelectedNodeId==n.Id?"ng-selected":"")" role="button" tabindex="0" aria-disabled="@(!CanSelectNode&&!Writable?"true":"false")" aria-label="@($"Node {text}")" aria-pressed="@(SelectedNodeId==n.Id?"true":"false")" @onclick="()=>SelectNode(n.Id,renderedRevision)" @onkeydown="e=>NodeKey(e,n.Id,renderedRevision)"><title>@text · @F(n.X), @F(n.Y)</title>
@if(n.Shape==NgDiagramShape.Ellipse){<ellipse cx="@F(n.Width/2)" cy="@F(n.Height/2)" rx="@F(n.Width/2-2)" ry="@F(n.Height/2-2)"/>}else if(n.Shape==NgDiagramShape.Diamond){<polygon points="@($"{F(n.Width/2)},2 {F(n.Width-2)},{F(n.Height/2)} {F(n.Width/2)},{F(n.Height-2)} 2,{F(n.Height/2)}")"/>}else{<rect x="2" y="2" width="@F(n.Width-4)" height="@F(n.Height-4)" rx="6"/>}
<text x="@F(n.Width/2)" y="@F(n.Height/2)" text-anchor="middle" dominant-baseline="middle">@Short(text,Math.Max(3,(int)(n.Width/(n.Shape==NgDiagramShape.Diamond?15:9))))</text></g>}
</svg></div>
@if(Value.Nodes.Count==0){<p>@EmptyText</p>}
<p role="status">@Value.Nodes.Count nodes · @Value.Edges.Count connections · @message</p>
</section>
@code {
 [Parameter] public string Label { get; set; } = "Diagram";
 [Parameter, EditorRequired] public NgDiagramModel Value { get; set; } = new();
 [Parameter] public EventCallback<NgDiagramModel> ValueChanged { get; set; }
 [Parameter] public string? SelectedNodeId { get; set; }
 [Parameter] public EventCallback<string?> SelectedNodeIdChanged { get; set; }
 [Parameter] public string? SelectedEdgeId { get; set; }
 [Parameter] public EventCallback<string?> SelectedEdgeIdChanged { get; set; }
 [Parameter] public bool ReadOnly { get; set; }
 [Parameter] public bool SelectionReadOnly {get;set;}
 [Parameter] public Func<NgDiagramNode,string>? NodeLabel {get;set;}
 [Parameter] public Func<NgDiagramEdge,string>? EdgeLabel {get;set;}
 [Parameter] public string EmptyText {get;set;}="No nodes yet.";
 private string NodeText(NgDiagramNode n)=>NodeLabel?.Invoke(n)??n.Text;
 private string EdgeText(NgDiagramEdge e)=>EdgeLabel?.Invoke(e)??e.Text;
 private bool Writable=>!ReadOnly&&ValueChanged.HasDelegate;
 private bool CanSelectNode=>!SelectionReadOnly&&SelectedNodeIdChanged.HasDelegate;
 private bool CanSelectEdge=>!SelectionReadOnly&&SelectedEdgeIdChanged.HasDelegate;
 private long revision;
 private bool disposed;
 private bool Active(long expected)=>!disposed&&revision==expected;
 protected override void OnParametersSet(){revision++;message="";}
 private double zoom=1;
 private NgDiagramView? pendingView;
 private string message="";
 private readonly string marker="ng-arrow-"+Guid.NewGuid().ToString("N");
 private ElementReference svg,viewport;
 private IJSObjectReference? module;
 private DotNetObjectReference<NgDiagram>? reference;
 private NgDiagramModel? previous;
 protected override async Task OnAfterRenderAsync(bool firstRender) {
  if(firstRender){module=await JS.InvokeAsync<IJSObjectReference>("import","./_content/NextgenComponents.Blazor/diagram.js");if(disposed){await module.DisposeAsync();return;}reference=DotNetObjectReference.Create(this);await module.InvokeVoidAsync("attach",svg,reference);}
  if(module is not null && pendingView is {} view){pendingView=null;await module.InvokeVoidAsync("scroll",viewport,view.ScrollX,view.ScrollY);}
  if(module is not null && !ReferenceEquals(previous,Value)){previous=Value;await module.InvokeVoidAsync("cancel",svg);}
 }
 private static string F(double n)=>n.ToString("0.###",CultureInfo.InvariantCulture);
 private static string Short(string s,int count)=>s.Length>count?s[..(count-1)]+"…":s;
 private void ZoomBy(double step){if(disposed)return;revision++;zoom=Math.Clamp(zoom+step,.25,2);}
 private async Task Fit(){if(module is null||disposed)return;var expected=revision;var width=await module.InvokeAsync<double>("width",viewport);if(Active(expected))ZoomBy(Math.Clamp(width/Value.Width,.25,2)-zoom);}
 private async Task FitDiagram(){if(module is null||Value.Nodes.Count==0||disposed)return;var expected=revision;var size=await module.InvokeAsync<double[]>("size",viewport);if(!Active(expected))return;pendingView=Value.FitView(size[0],size[1]);ZoomBy(pendingView.Zoom-zoom);await module.InvokeVoidAsync("cancel",svg);}
 private async Task SelectNode(string id,long expected){
  if(!Active(expected)||!CanSelectNode||!Value.Nodes.Any(n=>n.Id==id))return;
  var source=Value;await SelectedEdgeIdChanged.InvokeAsync(null);
  if(!disposed&&ReferenceEquals(source,Value)&&CanSelectNode)await SelectedNodeIdChanged.InvokeAsync(id);
 }
 private async Task SelectEdge(string id,long expected){
  if(!Active(expected)||!CanSelectEdge||!Value.Edges.Any(e=>e.Id==id))return;
  var source=Value;await SelectedNodeIdChanged.InvokeAsync(null);
  if(!disposed&&ReferenceEquals(source,Value)&&CanSelectEdge)await SelectedEdgeIdChanged.InvokeAsync(id);
 }
 [JSInvokable] public async Task MoveNode(string id,double x,double y,long expected){
  if(!Active(expected)||!Writable||!double.IsFinite(x)||!double.IsFinite(y)||!Value.Nodes.Any(n=>n.Id==id))return;
  var source=Value;var next=source.Move(id,x,y);await SelectNode(id,expected);
  if(disposed||!Writable||!ReferenceEquals(source,Value))return;
  if(next.Nodes.First(n=>n.Id==id)!=source.Nodes.First(n=>n.Id==id)){message=$"Move requested for {id}.";await ValueChanged.InvokeAsync(next);}
  if(!disposed)StateHasChanged();
 }
 private async Task NodeKey(KeyboardEventArgs e,string id,long expected){if(!Active(expected))return;if(e.Key is "Enter" or " "){await SelectNode(id,expected);return;}if(!Writable)return;var n=Value.Nodes.FirstOrDefault(n=>n.Id==id);if(n is null)return;var step=e.ShiftKey?1:10;var delta=e.Key switch{"ArrowLeft"=>(-step,0),"ArrowRight"=>(step,0),"ArrowUp"=>(0,-step),"ArrowDown"=>(0,step),_=>(0,0)};if(delta!=(0,0))await MoveNode(id,n.X+delta.Item1,n.Y+delta.Item2,expected);}
 private Task EdgeKey(KeyboardEventArgs e,string id,long expected)=>e.Key is "Enter" or " "?SelectEdge(id,expected):Task.CompletedTask;
 public async ValueTask DisposeAsync(){disposed=true;revision++;if(module is not null){try{await module.InvokeVoidAsync("detach",svg);await module.DisposeAsync();}catch(JSDisconnectedException){}}reference?.Dispose();}
}
