@typeparam TItem
@implements IDisposable
<div class="ng-data-grid" aria-busy="@(loading?"true":"false")">
@if(loading){<p role="status">@LoadingText</p>}
@if(error){<p role="alert">@ErrorText <button type="button" @onclick="RetryReadAsync">@RetryText</button></p>}
<div class="ng-data-toolbar"><label class="ng-field">Search @Label<input class="ng-input" aria-label="@($"Search {Label}")" value="@search" @oninput="Search" /></label><span role="status">@SelectedIds.Count selected</span>@Toolbar @if(Editing is {} editor){<button type="button" class="ng-button ng-primary" disabled="@(!CanCreate)" @onclick="()=>BeginEdit(NgGridEditOperation.Create,default)">@editor.CreateText</button>} @if(MultiSort){<button type="button" disabled="@(sorts.Count==0)" @onclick="ClearSort">Clear sorting</button>}</div>
@if(CollapsibleGroups && IsGrouped){<div class="ng-data-toolbar"><button type="button" disabled="@(!CanBulk(false))" @onclick="()=>BulkGroups(false)">@(ReadGroupedRange is not null?ExpandWindowGroupsText:ReadGroupedData is null?ExpandGroupsText:ExpandPageGroupsText)</button><button type="button" disabled="@(!CanBulk(true))" @onclick="()=>BulkGroups(true)">@(ReadGroupedRange is not null?CollapseWindowGroupsText:ReadGroupedData is null?CollapseGroupsText:CollapsePageGroupsText)</button></div>}
@if(Export is {} export){<div class="ng-data-toolbar">
<label class="ng-field">@export.ScopeText<select class="ng-input" aria-label="@export.ScopeText" value="@exportScope" disabled="@exporting" @onchange="ChangeExportScope">
<option value="Page">@(IsRange?LoadedWindowText:export.PageText)</option><option value="Filtered" disabled="@(IsRemote && export.ReadExportData is null)">@export.FilteredText</option><option value="Selected" disabled="@(IsRemote && export.ReadExportData is null)">@export.SelectedText</option></select></label>
<button type="button" class="ng-button" disabled="@(!CanExport)" @onclick="ExportAsync">@export.ExportText</button>
@if(exporting){<span role="status">@export.BusyText</span><button type="button" class="ng-button" @onclick="CancelExport">@export.CancelText</button>}
@if(exportError){<span role="alert">@export.ErrorText</span>}else if(exportReady){<span role="status">@export.ReadyText</span>}
</div>}
<div @key="rangeEpoch" class="ng-table-scroll @(Virtualize?"ng-virtual-table":"") @(VariableRowHeight?"ng-variable-table":"")" style="@VirtualStyle" tabindex="0" aria-label="@($"{Label} table scroll area")">
<table class="ng-data-table"><caption class="ng-sr-only">@Label</caption><thead><tr>
@if(Selectable){<th scope="col"><input type="checkbox" aria-label="@(IsRange?SelectWindowText:Virtualize && !IsRemote?"Select results":"Select page")" checked="@(Eligible.Count>0 && Eligible.All(x=>SelectedIds.Contains(RowId(x))))" disabled="@(Eligible.Count==0 || SelectionReadOnly || !SelectedIdsChanged.HasDelegate)" aria-checked="@(Eligible.Any(x=>SelectedIds.Contains(RowId(x))) && !Eligible.All(x=>SelectedIds.Contains(RowId(x)))?"mixed":null)" @onchange="SelectPage" /></th>}
@foreach(var column in Columns){var sort=sorts.FirstOrDefault(x=>x.Key==column.Key);<th scope="col" aria-sort="@(sort is not null?(sort.Descending?"descending":"ascending"):"none")">@if(column.Sortable){<button type="button" @onclick="()=>Sort(column.Key)">@column.Title @(sort is not null?$"{(sort.Descending?"↓":"↑")}{(MultiSort?sorts.IndexOf(sort)+1:"")}":"↕")</button>}else{@column.Title}</th>}
@if(HasActions){<th scope="col">Actions</th>}
</tr></thead>
@if(!loading && !error && Visible.Count==0 && (!IsRange || rangeKnown && total==0)){<tbody><tr><td colspan="@(Columns.Count+(Selectable?1:0)+(HasActions?1:0))" class="ng-empty">@if(EmptyTemplate is not null){@EmptyTemplate}else{@EmptyText}</td></tr></tbody>}
@if(Virtualize){
<tbody>
<VirtualRows @ref="rangeRows" TItem="GridEntry" Provider="@(!IsRange?null:ReadRangeRows)" Enabled="Virtualize" VariableHeight="VariableRowHeight" ItemKey="EntryKey" RowHeight="RowHeight" Items="Entries" Context="entry">
<Placeholder><tr aria-hidden="true"><td colspan="@(Columns.Count+(Selectable?1:0)+(HasActions?1:0))" style="height:@(RowHeight)px">@(error?ErrorText:LoadingText)</td></tr></Placeholder>
<ChildContent>
@if(!entry.HasRow && entry.Group is null){<tr aria-hidden="true"><td colspan="@(Columns.Count+(Selectable?1:0)+(HasActions?1:0))">@ErrorText</td></tr>}
@if(entry.Group is {} group){<tr class="ng-grid-group"><th scope="row" colspan="@(Columns.Count+(Selectable?1:0)+(HasActions?1:0))" style="padding-inline-start:@(14+group.Depth*20)px">
@if(CollapsibleGroups){<button type="button" aria-expanded="@(!IsCollapsed(group.Id)?"true":"false")" aria-label="@ToggleLabel(group)" disabled="@(!CanToggleGroups)" @onclick="()=>ToggleGroup(group.Id)"><span aria-hidden="true">@(IsCollapsed(group.Id)?"▸":"▾")</span> @Caption(group)</button>}else{@Caption(group)}
@foreach(var summary in group.Summaries??[]){<span class="ng-group-summary"> · @SummaryText(summary)</span>}
@foreach(var aggregate in GroupAggregates){<span class="ng-group-summary"> · @aggregate.Text(group.Items)</span>}
</th></tr>}
@if(entry.HasRow){var row=entry.Row!;var id=RowId(row);
<tr @key="id" class="@(SelectedIds.Contains(id)?"ng-row-selected":"")">
@if(Selectable){<td><input type="checkbox" aria-label="@($"Select {id}")" checked="@SelectedIds.Contains(id)" disabled="@(!CanChange(row))" @onchange="()=>Toggle(row)" /></td>}
@foreach(var column in Columns){<td>@if(editCell==column.Key && editId==id && CellField(column.Key) is {} activeField){@FieldEditor(activeField)}else if(column.Template is not null){@column.Template(row)}else{@column.Text(row)}@if(Editing is {CellEditing:true} && CellField(column.Key) is not null && !(editCell==column.Key && editId==id)){<button type="button" class="ng-button" aria-label="@($"{Editing.UpdateText} {column.Title} {id}")" disabled="@(!CanEditRow(row,false))" @onclick="()=>BeginCell(row,column.Key)">@Editing.UpdateText</button>}</td>}
@if(HasActions){<td>@if(RowActions is not null){@RowActions(row)}@if(Editing is {} edit){<button type="button" class="ng-button" aria-label="@($"{edit.UpdateText} {id}")" disabled="@(!CanEditRow(row,false))" @onclick="()=>BeginEdit(NgGridEditOperation.Update,row)">@edit.UpdateText</button><button type="button" class="ng-button" aria-label="@($"{edit.DeleteText} {id}")" disabled="@(!CanEditRow(row,true))" @onclick="()=>BeginEdit(NgGridEditOperation.Delete,row)">@edit.DeleteText</button>}</td>}
</tr>}
</ChildContent>
</VirtualRows>
</tbody>
}else{
@foreach(var section in DisplaySections){
<tbody>
@if(section.Group is {} group){<tr class="ng-grid-group"><th scope="rowgroup" colspan="@(Columns.Count+(Selectable?1:0)+(HasActions?1:0))" style="padding-inline-start:@(14+group.Depth*20)px">
@if(CollapsibleGroups){<button type="button" aria-expanded="@(!IsCollapsed(group.Id)?"true":"false")" aria-label="@ToggleLabel(group)" disabled="@(!CanToggleGroups)" @onclick="()=>ToggleGroup(group.Id)"><span aria-hidden="true">@(IsCollapsed(group.Id)?"▸":"▾")</span> @Caption(group)</button>}else{@Caption(group)}
@foreach(var summary in group.Summaries??[]){<span class="ng-group-summary"> · @SummaryText(summary)</span>}
@foreach(var aggregate in GroupAggregates){<span class="ng-group-summary"> · @aggregate.Text(group.Items)</span>}
</th></tr>}
@foreach(var row in section.Rows){var id=RowId(row);
<tr @key="id" class="@(SelectedIds.Contains(id)?"ng-row-selected":"")">
@if(Selectable){<td><input type="checkbox" aria-label="@($"Select {id}")" checked="@SelectedIds.Contains(id)" disabled="@(!CanChange(row))" @onchange="()=>Toggle(row)" /></td>}
@foreach(var column in Columns){<td>@if(editCell==column.Key && editId==id && CellField(column.Key) is {} activeField){@FieldEditor(activeField)}else if(column.Template is not null){@column.Template(row)}else{@column.Text(row)}@if(Editing is {CellEditing:true} && CellField(column.Key) is not null && !(editCell==column.Key && editId==id)){<button type="button" class="ng-button" aria-label="@($"{Editing.UpdateText} {column.Title} {id}")" disabled="@(!CanEditRow(row,false))" @onclick="()=>BeginCell(row,column.Key)">@Editing.UpdateText</button>}</td>}
@if(HasActions){<td>@if(RowActions is not null){@RowActions(row)}@if(Editing is {} edit){<button type="button" class="ng-button" aria-label="@($"{edit.UpdateText} {id}")" disabled="@(!CanEditRow(row,false))" @onclick="()=>BeginEdit(NgGridEditOperation.Update,row)">@edit.UpdateText</button><button type="button" class="ng-button" aria-label="@($"{edit.DeleteText} {id}")" disabled="@(!CanEditRow(row,true))" @onclick="()=>BeginEdit(NgGridEditOperation.Delete,row)">@edit.DeleteText</button>}</td>}
</tr>}
</tbody>}
}
</table></div>
@if(editOperation is null && editError is not null){<p role="alert">@editError</p>}
@if(editOperation is {} operation && Editing is {} config){
<section class="ng-grid-editor" aria-label="@(operation==NgGridEditOperation.Create?config.CreateText:operation==NgGridEditOperation.Delete?config.DeleteText:config.UpdateText)" aria-busy="@(saving?"true":"false")">
<h3>@(operation==NgGridEditOperation.Create?config.CreateText:operation==NgGridEditOperation.Delete?config.ConfirmDeleteText:config.UpdateText) @editId</h3>
@if(editError is not null){<p role="alert">@editError</p>}
@if(saving){<p role="status">@config.SavingText</p>}
@if(operation!=NgGridEditOperation.Delete){if(editCell is null){foreach(var field in config.Fields){@FieldEditor(field)}}}
<div class="ng-data-toolbar"><button type="button" class="ng-button ng-primary" disabled="@(!CanCommit)" @onclick="CommitEdit">@(IsBatch?config.StageText:operation==NgGridEditOperation.Delete?config.DeleteText:config.SaveText)</button>
<button type="button" class="ng-button" disabled="@saving" @onclick="CloseEdit">@config.CancelText</button></div>
</section>}
@if(IsBatch && batchChanges.Count>0 && Editing is {} batchConfig){
<section class="ng-grid-editor" aria-label="@batchConfig.PendingText" aria-busy="@(saving?"true":"false")">
<h3>@batchConfig.PendingText (@batchChanges.Count)</h3>
@if(saving){<p role="status">@batchConfig.SavingText</p>}
@foreach(var entry in batchChanges){var change=entry.Change;
<div @key="change.Key" class="ng-grid-field">
<strong>@ChangeLabel(change) @(change.Id??change.Key)</strong>
@if(change.Operation!=NgGridEditOperation.Delete){<dl>@foreach(var field in batchConfig.Fields){<dt>@field.Label</dt><dd>@change.Values.GetValueOrDefault(field.Key,"")</dd>}</dl>
<button type="button" class="ng-button" disabled="@(!CanReviewBatch)" @onclick="()=>BeginQueued(change.Key)">@batchConfig.UpdateText</button>}
<button type="button" class="ng-button" disabled="@(!CanReviewBatch)" @onclick="()=>UndoChange(change.Key)">@batchConfig.UndoText</button>
</div>}
<div class="ng-data-toolbar"><button type="button" class="ng-button ng-primary" disabled="@(!CanSaveBatch)" @onclick="SaveBatch">@batchConfig.SaveBatchText</button>
<button type="button" class="ng-button" disabled="@(!CanReviewBatch)" @onclick="DiscardBatch">@batchConfig.DiscardText</button></div>
</section>}
@if(IsRange){<p role="status">@LoadedWindowText: @(loadedSlotCount==0?"0":$"{rangeStart+1}–{rangeStart+loadedSlotCount}") / @total</p>}
@if(!IsRange && (!Virtualize || IsRemote)){<NgPager Total="Total" Page="page" PageChanged="ChangePage" PageSize="size" PageSizeChanged="Resize" Sizes="PageSizes" />}
</div>
@code {
 [Parameter] public bool VariableRowHeight {get;set;}
 private string EntryKey(GridEntry entry)=>entry.Group is {} group?"g:"+group.Id:"r:"+RowId(entry.Row!);
 [Parameter] public bool Virtualize {get;set;}
 [Parameter] public float RowHeight {get;set;}=48;
 [Parameter] public float ViewportHeight {get;set;}=384;
 private string? VirtualStyle=>Virtualize?$"height:{ViewportHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;overflow:auto;--ng-row-height:{RowHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)}px":null;
 private record GridEntry(NgGridGroup<TItem>? Group,TItem? Row,bool HasRow);
 private IReadOnlyList<GridEntry> Entries=>DisplaySections.SelectMany(s=>(s.Group is null?Enumerable.Empty<GridEntry>():[new GridEntry(s.Group,default,false)]).Concat(s.Rows.Select(r=>new GridEntry(null,r,true)))).ToArray();

 [Parameter] public NgGridExport<TItem>? Export{get;set;}
 private NgGridExportScope exportScope;
 private bool exporting,exportError,exportReady;
 private long exportRevision;
 private CancellationTokenSource? exportPending;
 private bool CanExport=>!disposed && !loading && !error && !saving && !exporting && Export is {ReadOnly:false} && (exportScope==NgGridExportScope.Page || !IsRemote || Export.ReadExportData is not null);
 private void ChangeExportScope(ChangeEventArgs e){if(exporting)return;if(Enum.TryParse<NgGridExportScope>(e.Value?.ToString(),out var scope) && Enum.IsDefined(scope)){exportScope=scope;exportReady=exportError=false;}}
 private void CancelExport(){++exportRevision;exportPending?.Cancel();exporting=exportReady=exportError=false;}
 private async Task ExportAsync(){
   if(!CanExport)return;
   var config=Export! with {ColumnKeys=Export!.ColumnKeys.ToArray()};var scope=exportScope;var ticket=++exportRevision;using var operation=new CancellationTokenSource();exportPending=operation;
   exporting=true;exportReady=exportError=false;
   try{
     var columns=config.Resolve(Columns).ToArray();
     // Snapshot query and selection before the first await. The adapter owns server ordering/filtering.
     var selected=SelectedIds.ToHashSet(StringComparer.Ordinal);
     IReadOnlyList<TItem> source;
     if(IsRemote && scope!=NgGridExportScope.Page){
       var request=new NgGridExportRequest(scope,search,Array.AsReadOnly(sorts.ToArray()),Array.AsReadOnly(RemoteGroupKeys.ToArray()),Array.AsReadOnly(selected.Order(StringComparer.Ordinal).ToArray()),config.MaxRows);
       source=(await config.ReadExportData!(request,operation.Token)).ToArray();
     }else source=(scope==NgGridExportScope.Page?DisplayRows:filtered).Where(r=>scope!=NgGridExportScope.Selected || selected.Contains(RowId(r))).ToArray();
     if(disposed || ticket!=exportRevision || Export is not {ReadOnly:false})return;
     ValidateRows(source);
     if(scope==NgGridExportScope.Selected && source.Any(r=>!selected.Contains(RowId(r))))throw new ArgumentException("Export returned unselected records.");
     var file=NgGridCsv.Create(source,columns,config);
     await config.OnExport(file,operation.Token);
     if(!disposed && ticket==exportRevision && Export is {ReadOnly:false})exportReady=true;
   }catch{if(!disposed && ticket==exportRevision)exportError=true;}
   finally{if(!disposed && ticket==exportRevision)exporting=false;if(ReferenceEquals(exportPending,operation))exportPending=null;}
 }
 [Parameter] public NgGridEditing<TItem>? Editing{get;set;}
 private bool HasActions=>RowActions is not null || Editing is not null;
 private NgGridEditOperation? editOperation;
 private string? editId,editError,editCell;
 private NgGridEditField? CellField(string key)=>Editing?.Fields.FirstOrDefault(f=>f.Key==key);
 private void BeginCell(TItem row,string key){if(Editing is not {CellEditing:true} || CellField(key) is null || !CanEditRow(row,false))return;BeginEdit(NgGridEditOperation.Update,row);if(editOperation==NgGridEditOperation.Update)editCell=key;}
 private NgGridEditorContext EditorContext(NgGridEditField field){
   var ticket=editRevision;
   return new(field,draft.GetValueOrDefault(field.Key,""),!CanCommit,value=>{
     if(ticket!=editRevision || !CanCommit || editOperation==NgGridEditOperation.Delete || (editCell is not null && editCell!=field.Key) || CellField(field.Key) is null)return;
     draft[field.Key]=value;StateHasChanged();
   });
 }
 private RenderFragment FieldEditor(NgGridEditField field)=> @<div class="ng-grid-field">@{var ctx=EditorContext(field);}
 @if(Editing?.EditorTemplate is {} template){@template(ctx)}else{<label class="ng-field">@field.Label<input class="ng-input" aria-label="@field.Label" aria-required="@(field.Required?"true":"false")" value="@ctx.Value" disabled="@ctx.Disabled" @oninput="e=>ctx.SetValue(e.Value?.ToString()??string.Empty)" /></label>}
 </div>;

 private Dictionary<string,string> draft=[];
 private bool saving;
 private long editRevision;
 private CancellationTokenSource? editPending;
 private bool CanCreate=>!disposed && !saving && !loading && !error && editOperation is null && Editing is {ReadOnly:false,AllowCreate:true};
 private TItem[] CurrentEditRows { get {
   var rows=(IsRemote?filtered:Items).Where(r=>RowId(r)==editId).ToArray();
   return rows.Length==0 && IsRemote && editKey is not null && editRecord is not null ? [editRecord] : rows;
 }}
 private bool Allowed(TItem row,bool delete)=>Editing is {ReadOnly:false} c && (delete?c.CanDelete?.Invoke(row)??true:c.CanUpdate?.Invoke(row)??true);
 private bool CanEditRow(TItem row,bool delete)=>!disposed && !saving && !batchChanges.Any(e=>e.Change.Id==RowId(row) && e.Change.Operation==NgGridEditOperation.Delete) && !loading && !error && editOperation is null && DisplayRows.Any(r=>RowId(r)==RowId(row) && Allowed(r,delete));
 private bool CanCommit=>!disposed && !saving && !loading && !error && Editing is {ReadOnly:false} && (editOperation==NgGridEditOperation.Create?Editing.AllowCreate:editOperation is not null && CurrentEditRows.Length==1 && Allowed(CurrentEditRows[0],editOperation==NgGridEditOperation.Delete));
 private void BeginEdit(NgGridEditOperation operation,TItem? row){
   if(operation==NgGridEditOperation.Create?!CanCreate:row is null || !CanEditRow(row,operation==NgGridEditOperation.Delete))return;
   if(operation!=NgGridEditOperation.Create)row=DisplayRows.First(r=>RowId(r)==RowId(row!));
   ++editRevision;editCell=null;editError=null;editRecord=row;editKey=null;
   try{draft=operation==NgGridEditOperation.Delete?[]:new(Editing!.Draft(row));editId=operation==NgGridEditOperation.Create?null:RowId(row!);editOperation=operation;
     var queued=operation==NgGridEditOperation.Create?null:batchChanges.FirstOrDefault(e=>e.Change.Id==editId);
     if(queued is not null){editKey=queued.Change.Key;if(operation==NgGridEditOperation.Update)draft=new(queued.Change.Values);}
   }
   catch{editError=Editing!.ErrorText;}
 }
 private void CloseEdit(){if(saving)return;++editRevision;editCell=null;editKey=null;editRecord=default;editOperation=null;editId=null;editError=null;draft=[];}
 private async Task CommitEdit(){
   if(!CanCommit)return;
   var config=Editing!;var operation=editOperation!.Value;
   var values=new System.Collections.ObjectModel.ReadOnlyDictionary<string,string>(new Dictionary<string,string>(draft));
   try{editError=operation==NgGridEditOperation.Delete?null:config.Fields.Any(f=>f.Required && string.IsNullOrWhiteSpace(values.GetValueOrDefault(f.Key)))?config.RequiredText:config.Validate?.Invoke(values);}catch{editError=config.ErrorText;}
   if(editError is not null)return;
   if(IsBatch){StageChange(operation,values);return;}
   saving=true;var ticket=++editRevision;using var operationPending=new CancellationTokenSource();editPending=operationPending;var token=operationPending.Token;
   try{var message=await config.Commit(operation,editId,values,token);if(disposed || ticket!=editRevision)return;editError=message;saving=false;if(message is null){CloseEdit();await ReloadAsync();}}
   catch{if(!disposed && ticket==editRevision)editError=config.ErrorText;}
   finally{if(!disposed && ticket==editRevision)saving=false;if(ReferenceEquals(editPending,operationPending))editPending=null;}
 }
 private void InvalidateEdit(){++editRevision;editPending?.Cancel();saving=false;CloseEdit();batchChanges.Clear();}
 [Parameter] public Func<NgDataRequest,CancellationToken,Task<NgDataResult<TItem>>>? ReadData{get;set;}
 [Parameter] public Func<NgGroupedDataRequest,CancellationToken,Task<NgGroupedDataResult<TItem>>>? ReadGroupedData{get;set;}
 [Parameter] public IReadOnlyList<string> RemoteGroupKeys{get;set;}=[];
 [Parameter] public Func<string,double?,string>? RemoteSummaryText{get;set;}
 [Parameter] public string ExpandPageGroupsText{get;set;}="Expand page groups";
 [Parameter] public string CollapsePageGroupsText{get;set;}="Collapse page groups";
 private bool IsRemote=>IsRange || ReadData is not null || ReadGroupedData is not null;
 private bool IsGrouped=>Selectors.Count>0 || ReadGroupedData is not null || ReadGroupedRange is not null;
 private string SummaryText(NgGroupSummary summary)=>RemoteSummaryText?.Invoke(summary.Title,summary.Value)??$"{summary.Title}: {summary.Value?.ToString("0.##")??"—"}";
 [Parameter] public Func<TItem,string>? GroupBy{get;set;}
 [Parameter] public Func<string,int,string>? GroupText{get;set;}
 [Parameter] public IReadOnlyList<Func<TItem,string>> GroupSelectors{get;set;}=[];
 [Parameter] public IReadOnlyList<NgGroupAggregate<TItem>> GroupAggregates{get;set;}=[];
 [Parameter] public bool CollapsibleGroups{get;set;}
 [Parameter] public HashSet<string> CollapsedGroups{get;set;}=[];
 [Parameter] public EventCallback<HashSet<string>> CollapsedGroupsChanged{get;set;}
 [Parameter] public bool GroupExpansionReadOnly{get;set;}
 [Parameter] public Func<IReadOnlyList<string>,bool,string>? GroupToggleLabel{get;set;}
 [Parameter] public string ExpandGroupsText{get;set;}="Expand all groups";
 [Parameter] public string CollapseGroupsText{get;set;}="Collapse all groups";
 private IReadOnlyList<NgGridGroup<TItem>> groups=[];
 private IReadOnlyList<Func<TItem,string>> Selectors=>GroupBy is null?GroupSelectors:[GroupBy];
 private bool IsCollapsed(string id)=>CollapsibleGroups && CollapsedGroups.Contains(id);
 private string Caption(NgGridGroup<TItem> g)=>GroupText?.Invoke(g.Key,g.Count)??$"{(g.Key.Length==0?"(empty)":g.Key)} ({g.Count})";
 private string ToggleLabel(NgGridGroup<TItem> g)=>GroupToggleLabel?.Invoke(g.Path,!IsCollapsed(g.Id))??$"{(IsCollapsed(g.Id)?"Expand":"Collapse")} {string.Join(" / ",g.Path.Select(k=>k.Length==0?"(empty)":k))}";
 private bool CanToggleGroups=>!disposed && !loading && !error && CollapsibleGroups && !GroupExpansionReadOnly && CollapsedGroupsChanged.HasDelegate && IsGrouped;
 private bool CanBulk(bool collapse)=>CanToggleGroups && NgDataOperations.AllGroups(groups).Any(g=>CollapsedGroups.Contains(g.Id)!=collapse);
 private async Task ToggleGroup(string id){if(!CanToggleGroups || !DisplaySections.Any(s=>s.Group?.Id==id))return;var next=new HashSet<string>(CollapsedGroups,StringComparer.Ordinal);if(!next.Add(id))next.Remove(id);await CollapsedGroupsChanged.InvokeAsync(next);}
 private async Task BulkGroups(bool collapse){if(!CanBulk(collapse))return;var next=new HashSet<string>(CollapsedGroups,StringComparer.Ordinal);foreach(var g in NgDataOperations.AllGroups(groups)){if(collapse)next.Add(g.Id);else next.Remove(g.Id);}await CollapsedGroupsChanged.InvokeAsync(next);}
 private IReadOnlyList<(NgGridGroup<TItem>? Group,IReadOnlyList<TItem> Rows)> DisplaySections {
   get {if(ReadGroupedRange is not null)return groupedRangeEntries.Select(e=>(e.Group,(IReadOnlyList<TItem>)(e.HasRow?new[]{e.Row!}:Array.Empty<TItem>()))).ToArray();if(!IsGrouped)return [(null,Visible)];var ids=Visible.Select(RowId).ToHashSet();var result=new List<(NgGridGroup<TItem>?,IReadOnlyList<TItem>)>();
     void Walk(IEnumerable<NgGridGroup<TItem>> nodes){foreach(var g in nodes){var rows=g.Items.Where(r=>ids.Contains(RowId(r))).ToArray();if(rows.Length==0)continue;result.Add((g,!IsCollapsed(g.Id) && g.Children.Count==0?rows:[]));if(!IsCollapsed(g.Id))Walk(g.Children);}}
     Walk(groups);return result;
   }
 }
 private IReadOnlyList<TItem> DisplayRows=>DisplaySections.SelectMany(s=>s.Rows).ToArray();
 private bool wasGrouped;
 [Parameter] public object? DataVersion{get;set;}
 [Parameter] public bool MultiSort{get;set;}
 [Parameter] public string LoadingText{get;set;}="Loading records…";
 [Parameter] public string ErrorText{get;set;}="Unable to load records.";
 [Parameter] public string RetryText{get;set;}="Retry";
 [Parameter] public IReadOnlyList<TItem> Items{get;set;}=[];
 [Parameter,EditorRequired] public IReadOnlyList<NgDataColumn<TItem>> Columns{get;set;}=[];
 [Parameter,EditorRequired] public Func<TItem,string> RowId{get;set;}=default!;
 [Parameter] public string Label{get;set;}="Records";
 [Parameter] public string EmptyText{get;set;}="No matching records.";
 [Parameter] public Func<TItem,bool>? CanSelect{get;set;}
 [Parameter] public bool SelectionReadOnly{get;set;}
 [Parameter] public RenderFragment? EmptyTemplate{get;set;}
 [Parameter] public IReadOnlyList<int> PageSizes{get;set;}=[5,10,25,50];
 [Parameter] public bool Selectable{get;set;}=true;
 [Parameter] public HashSet<string> SelectedIds{get;set;}=[];
 [Parameter] public EventCallback<HashSet<string>> SelectedIdsChanged{get;set;}
 [Parameter] public RenderFragment? Toolbar{get;set;}
 [Parameter] public RenderFragment<TItem>? RowActions{get;set;}
 [Parameter] public int InitialPageSize{get;set;}=5;
 private bool CanChange(TItem row)=>!loading && !error && Selectable && !SelectionReadOnly && SelectedIdsChanged.HasDelegate && (CanSelect?.Invoke(row)??true);
 private IReadOnlyList<TItem> Eligible=>DisplayRows.Where(x=>CanSelect?.Invoke(x)??true).ToArray();
 private string search="";
 private readonly List<NgSortDescriptor> sorts=[];
 private bool loading,error,disposed;
 private int total;
 private long revision;
 private CancellationTokenSource? pending;
 private object? previousVersion;
 private Delegate? previousReader;
 private string previousGroupKeys="";
 private string previousColumns="";
 private int Total=>!IsRemote?filtered.Count:total;
 private int page=1,size;
 private IReadOnlyList<TItem> filtered=[];

 private IReadOnlyList<TItem> Visible=>!IsRemote?(Virtualize?filtered:filtered.Skip((page-1)*size).Take(size).ToArray()):filtered;
 protected override void OnInitialized()=>size=Math.Max(1,InitialPageSize);
 protected override async Task OnParametersSetAsync(){
   if(VariableRowHeight && (!Virtualize || IsRange))throw new ArgumentException("VariableRowHeight requires virtual local data or server pages; continuous range readers require fixed heights.");
   if(Virtualize && (!float.IsFinite(RowHeight) || RowHeight<40 || !float.IsFinite(ViewportHeight) || ViewportHeight<RowHeight))throw new ArgumentException("Virtual rows require a finite height of at least 40 and a viewport at least one row high.");
   ValidateRangeMode();
   Export?.Resolve(Columns);
   if(!Equals(previousVersion,DataVersion) || previousReader!=ReaderIdentity || Export is null || Export.ReadOnly)CancelExport();
   Editing?.Check();
   if(!Equals(previousVersion,DataVersion) || previousReader!=ReaderIdentity || Editing is null || previousBatchMode!=IsBatch)InvalidateEdit();
   previousBatchMode=IsBatch;
   if(GroupBy is not null && GroupSelectors.Count>0)throw new ArgumentException("Use GroupBy or GroupSelectors, not both.");
   if(Selectors.Count>8)throw new ArgumentException("At most eight group levels are supported.");
   foreach(var aggregate in GroupAggregates)aggregate.Calculate(Array.Empty<TItem>());
   if(ReadGroupedData is not null){NgGroupedData.ValidateKeys(RemoteGroupKeys);if(ReadData is not null || Selectors.Count>0 || GroupAggregates.Count>0)throw new ArgumentException("Grouped remote mode cannot use ReadData or local grouping/aggregates.");}
   else if(ReadGroupedRange is null && RemoteGroupKeys.Count>0)throw new ArgumentException("Remote group keys require ReadGroupedData.");
   if(Selectors.Count>0 && ReadData is not null)throw new ArgumentException("Local grouping requires Items, not ReadData.");
   if(wasGrouped!=IsGrouped){page=1;wasGrouped=IsGrouped;}
   ValidateRows(Items);
   if(Columns.Count==0 || Columns.Any(x=>string.IsNullOrWhiteSpace(x.Key)) || Columns.Select(x=>x.Key).Distinct().Count()!=Columns.Count)throw new ArgumentException("Grid column keys must be nonempty and unique, with at least one column.");
   var changed=sorts.RemoveAll(s=>!Columns.Any(c=>c.Key==s.Key && c.Sortable))>0;
   if(!MultiSort && sorts.Count>1){sorts.RemoveRange(1,sorts.Count-1);changed=true;}
   var signature=string.Join("|",Columns.Select(c=>$"{c.Key}:{c.Sortable}"));
   if(!Equals(previousReader,ReaderIdentity) || previousGroupKeys!=NgDataOperations.GroupId(RemoteGroupKeys) || !Equals(previousVersion,DataVersion) || previousColumns!=signature || changed || ReadGroupedRange is not null && previousCollapsed!=CollapseSignature){
     previousCollapsed=CollapseSignature;previousReader=ReaderIdentity;previousGroupKeys=NgDataOperations.GroupId(RemoteGroupKeys);previousVersion=DataVersion;previousColumns=signature;page=1;await ReloadAsync();
   }else if(!IsRemote)Refresh();
 }
 private void ValidateRows(IReadOnlyList<TItem> rows){if(rows.Any(x=>string.IsNullOrWhiteSpace(RowId(x))) || rows.Select(RowId).Distinct().Count()!=rows.Count)throw new ArgumentException("Grid row IDs must be nonempty and unique.");}
 private void Refresh(){filtered=NgDataOperations.Query(Items,Columns,search,sorts);groups=NgDataOperations.GroupTree(filtered,Selectors);if(groups.Count>0)filtered=groups.SelectMany(g=>g.Items).ToArray();page=NgDataOperations.ClampPage(page,filtered.Count,size);}

 public async Task ReloadAsync(){
   if(disposed)return;
   if(IsRange){ResetRange();return;}
   var ticket=++revision;pending?.Cancel();pending?.Dispose();pending=new();var token=pending.Token;
   if(!IsRemote){loading=error=false;Refresh();return;}
   var reader=ReadData;var groupedReader=ReadGroupedData;loading=true;error=false;filtered=[];groups=[];StateHasChanged();
   try{
     IReadOnlyList<TItem> nextRows;IReadOnlyList<NgGridGroup<TItem>> nextGroups=[];int nextTotal;
     if(groupedReader is not null){
       var request=new NgGroupedDataRequest(page,size,search,Array.AsReadOnly(sorts.ToArray()),Array.AsReadOnly(RemoteGroupKeys.ToArray()));
       var result=await groupedReader(request,token);
       if(disposed || ticket!=revision)return;
       nextGroups=NgGroupedData.Validate(result,request,RowId);nextRows=nextGroups.SelectMany(g=>g.Items).ToArray();nextTotal=result.Total;
     }else{
       var request=new NgDataRequest(page,size,search,Array.AsReadOnly(sorts.ToArray()));
       var result=await reader!(request,token);
       if(disposed || ticket!=revision)return;
       if(result.Total<0 || result.Items.Count>size || result.Items.Count>result.Total)throw new ArgumentException("Invalid server page.");
       ValidateRows(result.Items);nextRows=result.Items.ToArray();nextTotal=result.Total;
     }
     total=nextTotal;
     var clamped=NgDataOperations.ClampPage(page,total,size);
     if(page!=clamped){page=clamped;await ReloadAsync();return;}
     filtered=nextRows;groups=nextGroups;
   }catch(Exception){if(!disposed && ticket==revision){error=true;filtered=[];groups=[];}}
   finally{if(!disposed && ticket==revision){loading=false;StateHasChanged();}}
 }
 private async Task Search(ChangeEventArgs e){search=e.Value?.ToString()??"";page=1;await ReloadAsync();}
 private async Task Sort(string key){
   if(!Columns.Any(c=>c.Key==key && c.Sortable))return;
   var old=sorts.FirstOrDefault(s=>s.Key==key);
   var sortPriority=old is null?sorts.Count:sorts.IndexOf(old);
   if(!MultiSort)sorts.Clear();else if(old is not null)sorts.Remove(old);
   var next=new NgSortDescriptor(key,old is not null && !old.Descending);
   // Preserve priority when toggling an existing descriptor.
   if(MultiSort && old is not null){var order=sortPriority;sorts.Insert(Math.Min(order,sorts.Count),next);}else sorts.Add(next);
   page=1;await ReloadAsync();
 }
 private async Task ClearSort(){sorts.Clear();page=1;await ReloadAsync();}
 private async Task ChangePage(int value){if(value==page)return;page=value;await ReloadAsync();}
 private async Task Resize(int value){size=value;page=1;await ReloadAsync();}
 public void Dispose(){CancelExport();InvalidateEdit();disposed=true;++revision;pending?.Cancel();pending?.Dispose();}
 private async Task Toggle(TItem row){var matches=(!IsRemote?Items:filtered).Where(x=>RowId(x)==RowId(row)).ToArray();if(matches.Length==0 || !DisplayRows.Any(r=>RowId(r)==RowId(row)) || !CanChange(matches[0]))return;var id=RowId(row);var next=new HashSet<string>(SelectedIds);if(!next.Add(id))next.Remove(id);await SelectedIdsChanged.InvokeAsync(next);}
 private async Task SelectPage(){if(loading || error || !Selectable || SelectionReadOnly || !SelectedIdsChanged.HasDelegate || Eligible.Count==0)return;var next=new HashSet<string>(SelectedIds);var remove=Eligible.All(x=>next.Contains(RowId(x)));foreach(var row in Eligible){if(remove)next.Remove(RowId(row));else next.Add(RowId(row));}await SelectedIdsChanged.InvokeAsync(next);}
}
