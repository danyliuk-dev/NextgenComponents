@inherits InputBase<string[]>
<fieldset class="ng-multiselect" disabled="@Disabled"><legend>@Label</legend>
<div class="ng-chips">@foreach(var selected in Value ?? []) { var option=Items.FirstOrDefault(x=>x.Value==selected);<button type="button" class="ng-chip" disabled="@Disabled" aria-label="@($"Remove {option?.Label ?? selected}")" @onclick="() => Toggle(selected)">@(option?.Label ?? selected) ×</button> }</div>
<input class="ng-input" aria-label="@($"Filter {Label}")" placeholder="Filter options…" @bind="query" @bind:event="oninput" />
<div class="ng-multiselect-options">
@foreach(var item in Items.Where(x=>x.Label.Contains(query,StringComparison.CurrentCultureIgnoreCase))) { <label class="ng-check"><input type="checkbox" checked="@((Value??[]).Contains(item.Value))" disabled="@(item.Disabled || Disabled || (MaxSelected is not null && (Value??[]).Length>=MaxSelected && !(Value??[]).Contains(item.Value)))" @onchange="() => Toggle(item.Value)" />@item.Label</label> }
@if(!Items.Any(x=>x.Label.Contains(query,StringComparison.CurrentCultureIgnoreCase))) { <span class="ng-empty">No matches</span> }
</div>
@if(MaxSelected is not null) { <small>@((Value??[]).Length) / @MaxSelected selected</small> }
@if(error is not null) { <span role="status" class="ng-field-error">@error</span> }
</fieldset>
@code {
 [Parameter] public string Label { get; set; } = "Options";
 [Parameter] public IReadOnlyList<NgOption> Items { get; set; } = [];
 [Parameter] public int? MaxSelected { get; set; }
 [Parameter] public bool Disabled { get; set; }
 private string query="";
 private string? error;
 private void Toggle(string item) { if(Disabled)return;var next=(Value??[]).ToList();error=null;if(!next.Remove(item)){if(Items.FirstOrDefault(x=>x.Value==item)?.Disabled==true)return;if(MaxSelected is not null && next.Count>=MaxSelected){error=$"Select at most {MaxSelected} options.";return;}next.Add(item);}CurrentValue=next.Distinct().ToArray(); }
 protected override bool TryParseValueFromString(string? value,out string[] result,[System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage) { result=[]; validationErrorMessage=null;return true; }
}
