@implements IDisposable
<EditForm EditContext="editContext" OnValidSubmit="Submit" OnInvalidSubmit="Invalid" FormName="Name" class="ng-form">
<DataAnnotationsValidator />
@if(ShowSummary&&messages.Count>0){
 <div class="ng-validation-summary" role="status">
 @if(SummaryTemplate is not null){@SummaryTemplate(messages)}
 else{<p>@SummaryTitle</p><ul>@foreach(var message in messages){<li>@message</li>}</ul>}
 </div>
}
<fieldset class="@(Fields is null?"ng-form-fields":"ng-form-fields ng-form-container")" disabled="@(Disabled||busy)" aria-busy="@(busy?"true":"false")">
@if(Fields is not null){
 <FormFieldsLayout Fields="Fields" FieldSpans="FieldSpans" Columns="Columns" MinColumnWidth="MinColumnWidth" Gap="Gap" />
}else if(Sections is not null){
 <FormSectionsLayout Sections="Sections" Disabled="@(Disabled||busy)" />
}else{@ChildContent}
@if(Actions is not null){<div class="ng-form-actions">@Actions</div>}
</fieldset>
@if(busy){<p role="status">@BusyText</p>}
@if(error){<p class="ng-form-error" role="alert">@ErrorText</p>}
</EditForm>
@code {
 [Parameter,EditorRequired] public object Model {get;set;}=default!;
 [Parameter] public string Name {get;set;}="ng-form";
 [Parameter] public string SummaryTitle {get;set;}="Please correct the highlighted fields.";
 [Parameter] public RenderFragment<IReadOnlyList<string>>? SummaryTemplate {get;set;}
 private EditContext editContext=default!;
 private IReadOnlyList<string> messages=Array.Empty<string>();
 private void ValidationChanged(object? sender,ValidationStateChangedEventArgs args){
  if(disposed||!ReferenceEquals(sender,editContext))return;
  messages=Array.AsReadOnly(editContext.GetValidationMessages().ToArray());
  _ = InvokeAsync(()=>{if(!disposed)StateHasChanged();});
 }
 [Parameter] public bool ShowSummary {get;set;}=true;
 [Parameter] public bool Disabled {get;set;}
 [Parameter] public string BusyText {get;set;}="Saving…";
 [Parameter] public string ErrorText {get;set;}="Unable to save. Try again.";
 [Parameter] public IReadOnlyList<RenderFragment>? Fields {get;set;}
 [Parameter] public IReadOnlyList<int>? FieldSpans {get;set;}
 [Parameter] public IReadOnlyList<NgFormSection>? Sections {get;set;}
 [Parameter] public int Columns {get;set;}=1;
 [Parameter] public int MinColumnWidth {get;set;}=240;
 [Parameter] public int Gap {get;set;}=16;
 [Parameter] public RenderFragment? Actions {get;set;}
 [Parameter] public RenderFragment? ChildContent {get;set;}
 [Parameter] public EventCallback<EditContext> OnValidSubmit {get;set;}
 [Parameter] public EventCallback<EditContext> OnInvalidSubmit {get;set;}
 private bool busy,error,disposed;private object? previous;private int revision;
 protected override void OnParametersSet(){
  if(Columns is <1 or >4)throw new ArgumentOutOfRangeException(nameof(Columns));
  if(MinColumnWidth is <120 or >1200)throw new ArgumentOutOfRangeException(nameof(MinColumnWidth));
  if(Gap is <0 or >64)throw new ArgumentOutOfRangeException(nameof(Gap));
  if(new object?[]{Fields,Sections,ChildContent}.Count(value=>value is not null)>1)throw new ArgumentException("Use Fields, Sections or ChildContent, not more than one.");
  if(FieldSpans is not null&&(Fields is null||FieldSpans.Count!=Fields.Count||FieldSpans.Any(span=>span is <0 or >4)))throw new ArgumentException("Supply one span (0–4) per field; zero fills the row.",nameof(FieldSpans));
  if(Fields?.Any(f=>f is null)==true)throw new ArgumentException("Fields cannot contain null entries.",nameof(Fields));
  if(Sections is not null){
   if(Sections.Any(section=>section is null)||Sections.Select(section=>section.Id).Distinct(StringComparer.Ordinal).Count()!=Sections.Count)throw new ArgumentException("Sections need unique nonempty IDs.",nameof(Sections));
   foreach(var group in Sections)group.Validate();
  }
if(!ReferenceEquals(previous,Model)||editContext is null){
  if(editContext is not null)editContext.OnValidationStateChanged-=ValidationChanged;
  editContext=new EditContext(Model);editContext.OnValidationStateChanged+=ValidationChanged;
  messages=Array.Empty<string>();previous=Model;revision++;busy=false;error=false;
 }}
 private async Task Submit(EditContext context){if(Disabled||busy||disposed||!OnValidSubmit.HasDelegate)return;var version=++revision;busy=true;error=false;try{await OnValidSubmit.InvokeAsync(context);}catch(Exception){if(!disposed&&revision==version)error=true;}finally{if(!disposed&&revision==version)busy=false;}}
 private Task Invalid(EditContext context)=>Disabled||busy||disposed?Task.CompletedTask:OnInvalidSubmit.InvokeAsync(context);
 public void Dispose(){disposed=true;revision++;if(editContext is not null)editContext.OnValidationStateChanged-=ValidationChanged;}
}
