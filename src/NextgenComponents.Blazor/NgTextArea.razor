@inherits InputBase<string?>
@inject IJSRuntime JS
<div class="ng-field ng-text-field">
<label for="@Id">@Label</label>
<div class="ng-text-editor ng-text-size-@Size ng-text-fill-@FillMode ng-text-rounded-@Rounded">
@if(PrefixTemplate is not null){<span class="ng-input-adornment">@PrefixTemplate</span>}
<textarea @ref="element" @attributes="AdditionalAttributes" id="@Id" class="ng-input @CssClass @(AutoSize?"ng-textarea-auto":"")" rows="@Rows" maxlength="@MaxLength" readonly="@ReadOnly" aria-describedby="@DescriptionIds" value="@CurrentValueAsString" @oninput="Input" @onchange="Commit" disabled="@Disabled" placeholder="@Placeholder"></textarea>
@if(ShowClearButton){<button type="button" class="ng-button" aria-label="@($"Clear {Label}")" disabled="@(Disabled||ReadOnly||string.IsNullOrEmpty(CurrentValue))" @onclick="Clear">Clear</button>}
@if(SuffixTemplate is not null){<span class="ng-input-adornment">@SuffixTemplate</span>}
</div>
@if(!string.IsNullOrEmpty(HelperText)){<small id="@(Id+"-help")">@HelperText</small>}
@if(HasCounter){<small id="@(Id+"-count")" class="ng-text-counter" data-over-limit="@(MaxLength is not null&&Count>MaxLength?"true":"false")" aria-live="polite" aria-atomic="true">@CountText</small>}
</div>
@code {
 [Parameter] public string CounterMode {get;set;}="native";
 [Parameter] public Func<int,int?,string>? CounterText {get;set;}
 private bool HasCounter=>CounterMode is "used" or "remaining";
 private int Count=>(CurrentValueAsString??"").Length;
 private string CountText=>CounterText?.Invoke(Count,MaxLength)??(CounterMode=="remaining"?(Count>MaxLength?$"{Count-MaxLength} over limit":$"{MaxLength-Count} remaining"):MaxLength is null?(Count==1?"1 character":$"{Count} characters"):$"{Count} / {MaxLength}");
 [Parameter] public string Id {get;set;}="ng-"+Guid.NewGuid().ToString("N");
 [Parameter] public string Label {get;set;}="Notes";
 [Parameter] public string Size {get;set;}="medium";
 [Parameter] public string Rounded {get;set;}="theme";
 [Parameter] public string FillMode {get;set;}="theme";
 [Parameter] public string? Placeholder {get;set;}
 [Parameter] public bool Disabled {get;set;}
 [Parameter] public bool ReadOnly {get;set;}
 [Parameter] public bool ShowClearButton {get;set;}
 [Parameter] public int? MaxLength {get;set;}
 [Parameter] public string? HelperText {get;set;}
 [Parameter] public RenderFragment? PrefixTemplate {get;set;}
 [Parameter] public RenderFragment? SuffixTemplate {get;set;}
 [Parameter] public int DebounceDelay {get;set;}=300;
 [Parameter] public EventCallback<string?> OnDebouncedChange {get;set;}
 private TextCompositionObserver? composition;
 private bool composing;
 private Task CompositionChanged(bool active,string? value)=>InvokeAsync(()=>{
  if(disposed)return;
  composing=active;CancelDebounce();
  if(!active&&CurrentValue==value)ScheduleDebounce(value);
 });
 private CancellationTokenSource? debounce;
 private string? pendingValue;
 private int pendingDelay;
 private void CancelDebounce(){debounce?.Cancel();debounce?.Dispose();debounce=null;}
 private void ScheduleDebounce(string? value){
  CancelDebounce();
  if(disposed||composing||Disabled||ReadOnly||!OnDebouncedChange.HasDelegate||CurrentValue!=value)return;
  pendingValue=CurrentValue;pendingDelay=DebounceDelay;
  debounce=new();_ = NotifyAfterDelay(debounce.Token,pendingValue);
 }
 private async Task NotifyAfterDelay(CancellationToken token,string? value){
  try{await Task.Delay(DebounceDelay,token);}catch(OperationCanceledException){return;}
  try{
   await InvokeAsync(async()=>{
    if(token.IsCancellationRequested||disposed||Disabled||ReadOnly||CurrentValue!=value||!OnDebouncedChange.HasDelegate)return;
    if(composition is null||!await composition.CanNotifyAsync(value))return;
    if(token.IsCancellationRequested||disposed||composing||Disabled||ReadOnly||CurrentValue!=value||!OnDebouncedChange.HasDelegate)return;
    CancelDebounce();await OnDebouncedChange.InvokeAsync(value);
   });
  }catch(Exception error){if(!disposed)await DispatchExceptionAsync(error);}
 }
 [Parameter] public EventCallback<string?> OnCommit {get;set;}
 [Parameter] public int Rows {get;set;}=4;
 [Parameter] public bool AutoSize {get;set;}
 [Parameter] public int MaxRows {get;set;}=12;
 private IJSObjectReference? sizeModule;
 private Task<IJSObjectReference>? sizeImport;
 private bool disposed;

 private ElementReference element;
 private string? DescriptionIds=>string.Join(" ",new[]{AdditionalAttributes?.GetValueOrDefault("aria-describedby")?.ToString(),string.IsNullOrEmpty(HelperText)?null:Id+"-help",HasCounter?Id+"-count":null}.Where(s=>!string.IsNullOrWhiteSpace(s)));
 public ValueTask FocusAsync()=>element.FocusAsync();
 protected override void OnParametersSet(){base.OnParametersSet();if(CounterMode is not ("native" or "hidden" or "used" or "remaining"))throw new ArgumentException("Use native, hidden, used or remaining.",nameof(CounterMode));if(CounterMode=="remaining"&&MaxLength is null)throw new ArgumentException("Remaining count requires MaxLength.",nameof(MaxLength));if(DebounceDelay is <0 or >60000)throw new ArgumentOutOfRangeException(nameof(DebounceDelay));if(debounce is not null&&(Disabled||ReadOnly||!OnDebouncedChange.HasDelegate||CurrentValue!=pendingValue||DebounceDelay!=pendingDelay))CancelDebounce();if(Size is not ("small" or "medium" or "large"))throw new ArgumentException("Use small, medium or large.",nameof(Size));if(FillMode is not ("theme" or "outline" or "filled" or "flat"))throw new ArgumentException("Use theme, outline, filled or flat.",nameof(FillMode));if(Rounded is not ("theme" or "none" or "small" or "medium" or "large" or "full"))throw new ArgumentException("Use theme, none, small, medium, large or full.",nameof(Rounded));if(MaxLength is <=0)throw new ArgumentOutOfRangeException(nameof(MaxLength));if(Rows is <1 or >30)throw new ArgumentOutOfRangeException(nameof(Rows));if(MaxRows is <1 or >30||(AutoSize&&MaxRows<Rows))throw new ArgumentOutOfRangeException(nameof(MaxRows),"Use 1–30 maximum rows, at least Rows when AutoSize is enabled.");}
 protected override async Task OnAfterRenderAsync(bool firstRender){
  if(disposed)return;
  if(OnDebouncedChange.HasDelegate)await (composition??=new(JS,CompositionChanged)).AttachAsync(element);
  if(AutoSize&&sizeModule is null){
   var module=await (sizeImport??=JS.InvokeAsync<IJSObjectReference>("import","./_content/NextgenComponents.Blazor/textarea-size.js").AsTask());
   if(disposed){await module.DisposeAsync();return;}sizeModule=module;
  }
  if(sizeModule is not null&&!disposed)await sizeModule.InvokeVoidAsync("update",element,AutoSize,Rows,MaxRows);
 }
 protected override void Dispose(bool disposing){disposed=true;CancelDebounce();if(composition is not null)_ = composition.DisposeAsync();_ = ReleaseSizeAsync();base.Dispose(disposing);}
 private async Task ReleaseSizeAsync(){try{if(sizeModule is not null){await sizeModule.InvokeVoidAsync("detach",element);await sizeModule.DisposeAsync();}}catch(JSDisconnectedException){}catch(TaskCanceledException){}}
 private async Task Clear(){if(disposed||Disabled||ReadOnly||string.IsNullOrEmpty(CurrentValue))return;if(composition is not null)await composition.ResetAsync();if(disposed||Disabled||ReadOnly)return;composing=false;CurrentValueAsString="";ScheduleDebounce("");await element.FocusAsync();}
 private void Input(ChangeEventArgs e){if(!disposed&&!Disabled&&!ReadOnly){var value=e.Value?.ToString();CurrentValueAsString=value;ScheduleDebounce(value);}}
 private Task Commit(ChangeEventArgs e)=>Disabled||ReadOnly?Task.CompletedTask:OnCommit.InvokeAsync(e.Value?.ToString());
 protected override bool TryParseValueFromString(string? value,out string? result,[System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage){result=value;validationErrorMessage=null;return true;}
}
