@inherits InputBase<string?>
<label class="ng-field" for="@Id">@Label
<textarea @attributes="AdditionalAttributes" id="@Id" class="ng-input @CssClass" rows="@Rows" maxlength="@MaxLength" value="@CurrentValueAsString" @oninput="e => CurrentValueAsString=e.Value?.ToString()" disabled="@Disabled" placeholder="@Placeholder"></textarea>
</label>
@code {
 [Parameter] public string Id { get; set; } = "ng-"+Guid.NewGuid().ToString("N");
 [Parameter] public string Label { get; set; } = "Notes";
 [Parameter] public string? Placeholder { get; set; }
 [Parameter] public int Rows { get; set; } = 4;
 [Parameter] public int? MaxLength { get; set; }
 [Parameter] public bool Disabled { get; set; }
 protected override bool TryParseValueFromString(string? value,out string? result,[System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage) { result=value; validationErrorMessage=null; return true; }
}
