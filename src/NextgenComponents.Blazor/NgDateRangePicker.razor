@using System.Linq.Expressions
@implements IDisposable
<fieldset class="ng-range" disabled="@Disabled"><legend>@Label</legend>
@if(Presets.Count>0||ShowClearButton){
<div class="ng-range-presets" aria-label="@($"{Label} presets")">
@foreach(var preset in Presets){
<button @key="preset.Id" type="button" class="ng-button" disabled="@(Disabled||ReadOnly||!ValueChanged.HasDelegate||!Allowed(preset))" aria-pressed="@(start==preset.Start&&end==preset.End?"true":"false")" @onclick="()=>Apply(preset)">@preset.Label</button>
}
@if(ShowClearButton){<button type="button" class="ng-button" disabled="@(Disabled||ReadOnly||!ValueChanged.HasDelegate)" @onclick="Clear">@ClearText</button>}
</div>
}
<div class="ng-form-grid" @key="editorRevision">
<NgDatePicker Label="Start date" Value="start" ValueChanged="StartChanged" ValueExpression="() => start" Min="Min" Max="Max" Disabled="Disabled" ReadOnly="ReadOnly" DisabledDate="DisabledDate" />
<NgDatePicker Label="End date" Value="end" ValueChanged="EndChanged" ValueExpression="() => end" Min="Min" Max="Max" Disabled="Disabled" ReadOnly="ReadOnly" DisabledDate="DisabledDate" />
</div>
@if(error is not null) { <span class="ng-field-error" role="status">@error</span> }
</fieldset>
@code {
 [CascadingParameter] private EditContext? Context { get; set; }
 [Parameter] public string Label { get; set; } = "Date range";
 [Parameter] public NgDateRange? Value { get; set; }
 [Parameter] public EventCallback<NgDateRange?> ValueChanged { get; set; }
 [Parameter] public Expression<Func<NgDateRange?>>? ValueExpression { get; set; }
 [Parameter] public DateOnly? Min { get; set; }
 [Parameter] public DateOnly? Max { get; set; }
 [Parameter] public bool ReadOnly { get; set; }
 [Parameter] public Func<DateOnly,bool>? DisabledDate { get; set; }
 [Parameter] public bool Disabled { get; set; }
 [Parameter] public IReadOnlyList<NgDateRangePreset> Presets {get;set;}=Array.Empty<NgDateRangePreset>();
 [Parameter] public bool ShowClearButton {get;set;}
 [Parameter] public string ClearText {get;set;}="Clear range";
 private int editorRevision;
 private bool disposed;
 private bool Allowed(NgDateRangePreset preset)=>!preset.Disabled&&NgDateRules.Allowed(preset.Start,Min,Max,DisabledDate)&&NgDateRules.Allowed(preset.End,Min,Max,DisabledDate);
 private Task Apply(NgDateRangePreset preset)=>disposed||Disabled||ReadOnly||!ValueChanged.HasDelegate||!Presets.Any(p=>ReferenceEquals(p,preset))||!Allowed(preset)?Task.CompletedTask:SetRange(new(preset.Start,preset.End));
 private Task Clear()=>disposed||Disabled||ReadOnly||!ShowClearButton||!ValueChanged.HasDelegate?Task.CompletedTask:SetRange(null);
 private async Task SetRange(NgDateRange? next){
  start=next?.Start;end=next?.End;previous=next;editorRevision++;
  await ValueChanged.InvokeAsync(next);
  if(disposed)return;
  if(messages is not null)registered?.NotifyFieldChanged(field);
  UpdateError();
 }
 private DateOnly? start,end;
 private NgDateRange? previous;
 private bool initialized;
 private string? error;
 private EditContext? registered;
 private ValidationMessageStore? messages;
 private FieldIdentifier field;
 protected override void OnParametersSet() {
  if(Presets is null||Presets.Any(p=>p is null||string.IsNullOrWhiteSpace(p.Id)||string.IsNullOrWhiteSpace(p.Label)||p.Start>p.End)||Presets.Select(p=>p.Id).Distinct(StringComparer.Ordinal).Count()!=Presets.Count)throw new ArgumentException("Presets require unique IDs, labels and ordered dates.",nameof(Presets));
  if(string.IsNullOrWhiteSpace(ClearText))throw new ArgumentException("ClearText cannot be blank.",nameof(ClearText));
  if (Min > Max) throw new ArgumentException("Min must not exceed Max.");
  if(!initialized || Value != previous) { start=Value?.Start; end=Value?.End; previous=Value; initialized=true; }
  if (Context != registered) { Detach(); registered=Context; if(Context is not null && ValueExpression is not null) { field=FieldIdentifier.Create(ValueExpression); messages=new(Context); Context.OnValidationRequested+=Validate; } }
 }
 private async Task StartChanged(DateOnly? value) { if (disposed || Disabled || ReadOnly) return; start=value; await Changed(); }
 private async Task EndChanged(DateOnly? value) { if (disposed || Disabled || ReadOnly) return; end=value; await Changed(); }
 private async Task Changed() { var next=new NgDateRange(start,end); previous=next; await ValueChanged.InvokeAsync(next); if(messages is not null) registered?.NotifyFieldChanged(field); UpdateError(); }
 private void Validate(object? sender, ValidationRequestedEventArgs e) => UpdateError();
 private void UpdateError() { error=NgDateRules.RangeError(new(start,end)) ?? (new[]{start,end}.Any(d => d is not null && !NgDateRules.Allowed(d.Value,Min,Max,DisabledDate)) ? "This date is not available." : null); messages?.Clear(); if(error is not null) messages?.Add(field,error); registered?.NotifyValidationStateChanged(); StateHasChanged(); }
 private void Detach() { if(registered is not null) { registered.OnValidationRequested-=Validate; messages?.Clear(); registered.NotifyValidationStateChanged(); } messages=null; }
 public void Dispose() { disposed=true;Detach(); }
}
