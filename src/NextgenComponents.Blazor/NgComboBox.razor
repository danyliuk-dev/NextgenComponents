@inherits InputBase<string?>
@inject IJSRuntime JS
<div @ref="root" class="ng-combo ng-field" @onkeydown="KeyDown"><label for="@Id">@Label</label>
<div class="ng-combo-editor"><input id="@Id" class="ng-input @CssClass" value="@query" readonly="@ReadOnly" placeholder="@Placeholder" @oninput="Search" @onfocus="() => open=!ReadOnly" disabled="@Disabled" role="combobox" aria-expanded="@(open ? "true" : "false")" aria-autocomplete="list" aria-controls="@(Id+"-options")" aria-activedescendant="@(open && active>=0 && active<Filtered.Count ? Id+"-option-"+active : null)" autocomplete="off" />
@if(ShowClearButton){<button type="button" class="ng-button" aria-label="@($"Clear {Label}")" disabled="@(Disabled||ReadOnly||query.Length==0)" @onclick="Clear"><span aria-hidden="true">×</span></button>}
</div>
@if(open && !Disabled && !ReadOnly) {
 <div class="ng-options" role="listbox" id="@(Id+"-options")" aria-label="@Label">
 @if(Filtered.Count==0) { <span class="ng-empty">@EmptyText</span> }
 @for(var i=0;i<Filtered.Count;i++) { var option=Filtered[i];var index=i;
 <button type="button" role="option" aria-label="@option.Label" id="@(Id+"-option-"+i)" class="ng-option @(active==i ? "ng-active" : "")" disabled="@option.Disabled" aria-selected="@(Value==option.Value ? "true":"false")" @onclick="() => Select(option)">@if(ItemTemplate is not null){@ItemTemplate(option)}else{@option.Label}</button>
 }
 </div>
}
@if(error is not null) { <span class="ng-field-error" role="status">@error</span> }
</div>
@code {
 private ElementReference root;
 protected override async Task OnAfterRenderAsync(bool first) { if(first) { var module=await JS.InvokeAsync<IJSObjectReference>("import","./_content/NextgenComponents.Blazor/nextgen.js");await module.InvokeVoidAsync("combo",root);await module.DisposeAsync(); } }
 [Parameter] public string Id { get; set; } = "ng-"+Guid.NewGuid().ToString("N");
 [Parameter] public string Label { get; set; } = "Choose an option";
 [Parameter] public IReadOnlyList<NgOption> Items { get; set; } = [];
 [Parameter] public bool Disabled { get; set; }
 [Parameter] public bool ReadOnly {get;set;}
 [Parameter] public bool ShowClearButton {get;set;}
 [Parameter] public string? Placeholder {get;set;}
 [Parameter] public string EmptyText {get;set;}="No matches";
 [Parameter] public string FilterMode {get;set;}="contains";
 [Parameter] public int MinLength {get;set;}
 [Parameter] public RenderFragment<NgOption>? ItemTemplate {get;set;}
 private NgOption[] snapshot=[];
 private string query="";
 private string? previous,error;
 private bool open,initialized;
 private int active=-1;
 private List<NgOption> Filtered => Items.Where(x=>NgFilterRules.Matches(x.Label,query,FilterMode,MinLength)).ToList();
 protected override void OnParametersSet() { base.OnParametersSet();NgFilterRules.Validate(FilterMode,MinLength);NgFilterRules.ValidateItems(Items);if(Disabled||ReadOnly)open=false;if(!initialized || Value!=previous || !snapshot.SequenceEqual(Items)) { if(initialized&&!snapshot.SequenceEqual(Items))CurrentValueAsString=Value;query=Items.FirstOrDefault(x=>x.Value==Value)?.Label ?? ""; previous=Value; initialized=true;snapshot=Items.ToArray();active=-1; } }
 private void Search(ChangeEventArgs e) { if(Disabled||ReadOnly)return;error=null;query=e.Value?.ToString()??"";open=true;active=-1;var match=Items.FirstOrDefault(x=>!x.Disabled && string.Equals(x.Label,query,StringComparison.OrdinalIgnoreCase)); CurrentValueAsString=match?.Value ?? (query.Length==0 ? "" : "\u0000"+query);previous=Value; }
 private void Clear(){if(Disabled||ReadOnly)return;CurrentValueAsString="";previous=Value;query="";error=null;active=-1;open=false;}
 private void Select(NgOption option) { if(Disabled||ReadOnly||option.Disabled||!Items.Contains(option))return;CurrentValueAsString=option.Value;previous=Value;query=option.Label;open=false;error=null; }
 private void KeyDown(KeyboardEventArgs e) { if(Disabled||ReadOnly)return; if(e.Key=="Escape") { open=false;return; } if(e.Key=="ArrowDown"||e.Key=="ArrowUp") {open=true;var list=Filtered; if(list.Count>0){var direction=e.Key=="ArrowDown"?1:-1;for(var count=0;count<list.Count;count++){active=(active+direction+list.Count)%list.Count;if(!list[active].Disabled)break;}}} if(e.Key=="Enter" && open && active>=0 && active<Filtered.Count) Select(Filtered[active]); }
 protected override bool TryParseValueFromString(string? value,out string? result,[System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage) { error=null;result=null;if(string.IsNullOrEmpty(value)) { validationErrorMessage=null;return true; }var match=Items.FirstOrDefault(x=>x.Value==value && !x.Disabled);if(match is null)error="Choose an option from the list.";else result=match.Value;validationErrorMessage=error;return error is null; }
}
