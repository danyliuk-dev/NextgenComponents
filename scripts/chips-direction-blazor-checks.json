      "evaluate": "(()=>{const root=document.querySelector('[aria-label=\"Directional topics\"]');const chips=[...root.querySelectorAll('[data-chip-id]')];const r=chips.map(e=>e.getBoundingClientRect());if(!(r[0].x>r[1].x&&r[2].y>r[0].y))throw Error('RTL rows');const btn=chips[0].querySelector('.ng-chip-remove'),label=chips[0].querySelector('.ng-chip-label');const style=getComputedStyle(btn);if(style.borderRightWidth!=='1px'||style.borderLeftWidth!=='0px'||btn.getBoundingClientRect().x>=label.getBoundingClientRect().x)throw Error('RTL remove divider');if(chips[0].querySelector('.ng-chip-leading').getBoundingClientRect().x<label.getBoundingClientRect().x)throw Error('leading');return \"PASS\";})()"
